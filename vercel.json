{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "jansen-dev.vercel.app"
        }
      ],
      "destination": "https://denforge.it.com/",
      "permanent": true
    },
    {
      "source": "/work/:path*",
      "has": [
        {
          "type": "host",
          "value": "jansen-dev.vercel.app"
        }
      ],
      "destination": "https://denforge.it.com/work/:path*",
      "permanent": true
    },
    {
      "source": "/services/:path*",
      "has": [
        {
          "type": "host",
          "value": "jansen-dev.vercel.app"
        }
      ],
      "destination": "https://denforge.it.com/services/:path*",
      "permanent": true
    },
    {
      "source": "/llms.txt",
      "has": [
        {
          "type": "host",
          "value": "jansen-dev.vercel.app"
        }
      ],
      "destination": "https://denforge.it.com/llms.txt",
      "permanent": true
    },
    {
      "source": "/llms-full.txt",
      "has": [
        {
          "type": "host",
          "value": "jansen-dev.vercel.app"
        }
      ],
      "destination": "https://denforge.it.com/llms-full.txt",
      "permanent": true
    },
    {
      "source": "/humans.txt",
      "has": [
        {
          "type": "host",
          "value": "jansen-dev.vercel.app"
        }
      ],
      "destination": "https://denforge.it.com/humans.txt",
      "permanent": true
    },
    {
      "source": "/portfolio.json",
      "has": [
        {
          "type": "host",
          "value": "jansen-dev.vercel.app"
        }
      ],
      "destination": "https://denforge.it.com/portfolio.json",
      "permanent": true
    },
    {
      "source": "/sitemap.xml",
      "has": [
        {
          "type": "host",
          "value": "jansen-dev.vercel.app"
        }
      ],
      "destination": "https://denforge.it.com/sitemap.xml",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}

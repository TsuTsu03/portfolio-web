---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Work from "../components/Work.astro";
import MobileWork from "../components/MobileWork.astro";
import Agents from "../components/Agents.astro";
import Approach from "../components/Approach.astro";
import Capabilities from "../components/Capabilities.astro";
import Proof from "../components/Proof.astro";
import Questions from "../components/Questions.astro";
import Contact from "../components/Contact.astro";
import Insights from "../components/Insights.astro";
import {
  businessNode,
  faqNode,
  personNode,
  portfolioItemListNode,
  profilePageNode,
  websiteNode,
} from "../lib/schema";
import { sortInsights } from "../lib/insights";
import { agents } from "../data/agents";

const entries = (await getCollection("work")).sort((a, b) => a.data.order - b.data.order);

/** The three bodies of work are presented as their own sections. */
const mobileEntries = entries.filter((entry) => entry.data.category === "Mobile");
const webEntries = entries.filter((entry) => entry.data.category !== "Mobile");
const insights = sortInsights(await getCollection("insights"));

const liveCount = entries.filter((entry) => entry.data.status === "Deployed").length;
const repoCount = entries.filter((entry) => entry.data.repositoryUrl !== null).length;

/** The most recent verification date across the collection, stated once. */
const verifiedDate = new Date(
  Math.max(...entries.map((entry) => entry.data.lastVerified.getTime()))
);
const verified = verifiedDate.toLocaleDateString("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
const verifiedIso = verifiedDate.toISOString().slice(0, 10);

/** knowsAbout is derived from what the projects actually used. */
const knowsAbout = [
  ...new Set(entries.flatMap((entry) => [...entry.data.technologies, ...entry.data.capabilities])),
].sort();

const jsonLd = [
  personNode(knowsAbout),
  businessNode(),
  websiteNode(),
  profilePageNode(entries),
  portfolioItemListNode(entries),
  faqNode(),
];
---

{/* Introduce the person before presenting projects and agent demos. */}
<BaseLayout path="/" jsonLd={jsonLd}>
  <Hero projectCount={entries.length} agentCount={agents.length} />
  <About />
  <Work entries={webEntries} />
  <MobileWork entries={mobileEntries} />
  <Agents />
  <Capabilities />
  <Approach />
  <Insights entries={insights} />
  <Proof
    projectCount={entries.length}
    liveCount={liveCount}
    repoCount={repoCount}
    verified={verified}
    verifiedIso={verifiedIso}
  />
  <Questions />
  <Contact />
</BaseLayout>

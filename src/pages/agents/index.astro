---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { agents } from "../../data/agents";
import { person, SITE_UPDATED, SITE_URL } from "../../data/site";

const jsonLd = [
  { "@type": "WebPage", "@id": `${SITE_URL}/agents#page`, url: `${SITE_URL}/agents`, name: "AI Agents by Den Jansen Flores", dateModified: SITE_UPDATED, author: { "@type": "Person", name: person.name } },
  { "@type": "ItemList", "@id": `${SITE_URL}/agents#list`, numberOfItems: agents.length, itemListElement: agents.map((agent, index) => ({ "@type": "ListItem", position: index + 1, name: agent.name, url: `${SITE_URL}/agents/${agent.slug}` })) },
];
---

<BaseLayout path="/agents" title="AI Agents by Den Jansen Flores | Explore the Interfaces" description="Explore Mara's growth desk, Alfred's command HUD and an interactive hotel front desk. Each public demo runs in its own interface with fictional data." jsonLd={jsonLd} dateModified={SITE_UPDATED}>
  <div class="shell pt-20 sm:pt-28">
    <p class="meta text-accent">Interactive work / 01–03</p>
    <h1 class="display mt-5 max-w-[16ch] text-[clamp(2.5rem,7vw,5rem)]">AI agents you can try</h1>
    <p class="mt-6 max-w-[68ch] text-lg leading-relaxed text-text-dim">Mara's growth desk, Alfred's command HUD and the hotel reception console each have a public walkthrough. See the screen, then work in that interface using fictional data.</p>
  </div>
  <div class="shell-wide mt-14 space-y-20 pb-24 lg:space-y-28">
    {agents.map((agent, index) => (
      <article class="border-t border-line-strong pt-8 sm:pt-10">
        <div class="flex flex-wrap items-baseline gap-x-6 gap-y-2">
          <span class="meta text-accent">0{index + 1} / 03</span>
          <h2 class="display-tight text-[clamp(2rem,4vw,3.5rem)]">{agent.name}</h2>
          <span class="meta">{agent.role}</span>
        </div>
        <a href={`/agents/${agent.slug}`} class="group mt-8 block overflow-hidden border border-line-strong bg-surface" aria-label={`Explore ${agent.name}'s UI and public demo`}>
          <img src={agent.screenshot} alt={agent.screenshotAlt} loading="lazy" class="aspect-[4/3] w-full object-cover object-top transition-transform duration-300 group-hover:scale-[1.01] sm:aspect-[16/9]" />
        </a>
        <div class="mt-6 grid gap-5 lg:grid-cols-[1fr_auto] lg:items-center">
          <p class="max-w-[68ch] text-lg text-text-dim">{agent.summary}</p>
          <a href={`/agents/${agent.slug}#demo`} class="btn btn-primary justify-center">Try it in the interface <span aria-hidden="true">↗</span></a>
        </div>
      </article>
    ))}
  </div>
</BaseLayout>

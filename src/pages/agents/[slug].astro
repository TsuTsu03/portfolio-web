---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { agents, type Agent } from "../../data/agents";
import { person, SITE_UPDATED, SITE_URL } from "../../data/site";

export function getStaticPaths() {
  return agents.map((agent) => ({ params: { slug: agent.slug }, props: { agent } }));
}

const { agent } = Astro.props as { agent: Agent };
const pageUrl = `${SITE_URL}/agents/${agent.slug}`;
const jsonLd = [
  { "@type": "WebPage", "@id": `${pageUrl}#page`, url: pageUrl, name: agent.title, description: agent.description, image: `${SITE_URL}${agent.screenshot}`, dateModified: SITE_UPDATED, author: { "@type": "Person", name: person.name }, breadcrumb: { "@id": `${pageUrl}#breadcrumb` } },
  { "@type": "BreadcrumbList", "@id": `${pageUrl}#breadcrumb`, itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: SITE_URL },
    { "@type": "ListItem", position: 2, name: "AI Agents", item: `${SITE_URL}/agents` },
    { "@type": "ListItem", position: 3, name: agent.name, item: pageUrl },
  ] },
  { "@type": "SoftwareApplication", "@id": `${pageUrl}#project`, name: agent.name, applicationCategory: agent.role, description: agent.summary, image: `${SITE_URL}${agent.screenshot}`, author: { "@type": "Person", name: person.name }, url: pageUrl },
];
---

<BaseLayout path={`/agents/${agent.slug}`} title={`${agent.title} | Den Jansen Flores`} description={agent.description} jsonLd={jsonLd} dateModified={SITE_UPDATED}>
  <article class="shell-wide pt-14 pb-24 sm:pt-20">
    <nav aria-label="Breadcrumb" class="meta flex flex-wrap items-center gap-2">
      <a href="/" class="text-text-dim hover:text-accent">Home</a><span aria-hidden="true">/</span>
      <a href="/agents" class="text-text-dim hover:text-accent">AI Agents</a><span aria-hidden="true">/</span>
      <span class="text-accent" aria-current="page">{agent.name}</span>
    </nav>

    <header class="mt-10 grid gap-9 border-b border-line-strong pb-10 lg:grid-cols-[1fr_0.65fr] lg:items-end">
      <div>
        <p class="meta text-accent">{agent.role}</p>
        <h1 class="display mt-4 text-[clamp(2.7rem,7vw,5.5rem)]">{agent.name}</h1>
        <p class="mt-5 max-w-[65ch] text-lg leading-relaxed text-text-dim">{agent.summary}</p>
        <a href="#demo" class="btn btn-primary mt-8">Use the interface <span aria-hidden="true">↓</span></a>
      </div>
      <div class="border-l-2 border-accent pl-6">
        <p class="meta text-accent">Project</p>
        <p class="mt-3 text-text">{agent.built}</p>
        <p class="meta mt-7 text-accent">Public demo</p>
        <p class="mt-3 text-text-dim">{agent.demo}</p>
      </div>
    </header>

    <section class="mt-12 sm:mt-16" aria-labelledby="screens-heading">
      <div class="flex flex-wrap items-end justify-between gap-3">
        <div><p class="meta text-accent">The screens</p><h2 id="screens-heading" class="display-tight mt-3 text-[clamp(1.8rem,4vw,3rem)]">Inside {agent.name}</h2></div>
        <p class="meta text-text-dim">Project interface / public sample data</p>
      </div>
      <div class="mt-7 grid gap-4 lg:grid-cols-[1.55fr_0.85fr]">
        <a href={agent.screenshot} target="_blank" rel="noopener noreferrer" class="block overflow-hidden border border-line-strong bg-surface" aria-label={`Open ${agent.name} primary interface screenshot`}>
          <img src={agent.screenshot} alt={agent.screenshotAlt} class="aspect-[16/10] w-full object-cover object-top" loading="eager" />
        </a>
        <a href={agent.secondaryScreenshot} target="_blank" rel="noopener noreferrer" class="block overflow-hidden border border-line-strong bg-surface" aria-label={`Open ${agent.name} second interface screenshot`}>
          <img src={agent.secondaryScreenshot} alt={agent.secondaryScreenshotAlt} class="aspect-[16/10] w-full object-cover object-top" loading="lazy" />
        </a>
      </div>
    </section>

    <section id="demo" class="mt-16 scroll-mt-24 border-t border-line-strong pt-10 sm:mt-20" aria-labelledby="demo-heading">
      <div class="flex flex-wrap items-end justify-between gap-5">
        <div><p class="meta text-accent">Interactive demo</p><h2 id="demo-heading" class="display-tight mt-3 text-[clamp(1.8rem,4vw,3rem)]">Work in {agent.name}'s interface</h2></div>
        <a href={agent.demoUrl} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">Open full screen <span aria-hidden="true">↗</span></a>
      </div>
      <p class="mt-5 max-w-[80ch] text-text-dim">{agent.demo}</p>
      <div class="mt-7 overflow-hidden border border-line-strong bg-surface">
        <iframe src={agent.demoUrl} title={`${agent.name} interactive public demo`} allow="microphone" loading="lazy" class="block h-[720px] w-full border-0 sm:h-[820px] lg:h-[900px]"></iframe>
      </div>
      <p class="mt-3 text-sm text-text-dim">On a small screen, scroll within the interface. You can also open it full screen.</p>
    </section>

    <section class="mt-16 border-t border-line-strong pt-9" aria-labelledby="capabilities-heading">
      <h2 id="capabilities-heading" class="display-tight text-2xl">What the project demonstrates</h2>
      <ul class="mt-6 grid gap-px border border-line bg-line md:grid-cols-3">
        {agent.capabilities.map((capability) => <li class="bg-ink p-5 text-sm text-text">{capability}</li>)}
      </ul>
      <a href="/agents" class="mt-7 inline-flex min-h-11 items-center border-b border-accent text-sm text-accent hover:text-text">Explore all AI agents</a>
    </section>
  </article>
</BaseLayout>

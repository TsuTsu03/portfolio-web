---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import BrandIcon from "../components/BrandIcon.astro";
import Icon from "../components/Icon.astro";
import {
  certifications,
  education,
  experience,
  person,
  services,
  skillGroups,
  SITE_UPDATED,
} from "../data/site";
import { breadcrumbNode, personNode, resumeWebPageNode, websiteNode } from "../lib/schema";

const entries = (await getCollection("work")).sort((a, b) => a.data.order - b.data.order);
/* Featured web builds plus every mobile build, so the résumé shows both kinds of work. */
const selected = [
  ...entries.filter((entry) => entry.data.featured && entry.data.category !== "Mobile").slice(0, 4),
  ...entries.filter((entry) => entry.data.category === "Mobile"),
];
const knowsAbout = [
  ...new Set(entries.flatMap((entry) => [...entry.data.technologies, ...entry.data.capabilities])),
];
const path = "/resume";
const jsonLd = [
  personNode(knowsAbout),
  websiteNode(),
  resumeWebPageNode(),
  breadcrumbNode([
    { name: "Home", path: "/" },
    { name: "Résumé", path },
  ]),
];
---

<BaseLayout
  path={path}
  title={`${person.name} résumé | Software solutions consultant and developer`}
  description="Résumé of Den Jansen Flores, a software solutions consultant and full-stack, mobile and AI developer in Metro Manila: experience, skills, certifications and projects."
  dateModified={SITE_UPDATED}
  jsonLd={jsonLd}
>
  <article class="resume-page pb-20 pt-28">
    <header class="shell">
      <nav aria-label="Breadcrumb" class="resume-screen-only mb-10">
        <ol class="meta flex flex-wrap items-center gap-2">
          <li><a href="/" class="transition-colors hover:text-accent">Home</a></li>
          <li aria-hidden="true" class="text-line-control">/</li>
          <li class="text-text" aria-current="page">Résumé</li>
        </ol>
      </nav>

      <div class="grid gap-10 lg:grid-cols-12 lg:items-end lg:gap-16">
        <div class="lg:col-span-8">
          <p class="meta mb-5">Professional profile</p>
          <h1 class="display text-[clamp(3rem,8vw,6.5rem)]">{person.name}</h1>
          <p class="mt-6 text-xl leading-relaxed text-text">
            {person.businessRole}. {person.role}, {person.thirdRole} and {person.secondRole}
          </p>
          <p class="lede mt-5">
            I help businesses replace manual work with software, and advise them on what is worth building. {person.yearsActive} years
            of experience building web platforms, Android and iOS apps, and controlled AI workflows. I work across React, Next.js, Vue and TypeScript on the front end, Node.js, Express.js
            and NestJS behind it, React Native, Expo and Flutter on mobile, and PostgreSQL, Supabase, MySQL, MongoDB and
            Firebase for data.
          </p>
        </div>

        <div class="lg:col-span-4">
          <dl class="border-t border-line">
            <div class="flex justify-between gap-4 border-b border-line py-3">
              <dt class="meta">Based in</dt>
              <dd class="text-right text-sm text-text">{person.locality}, {person.region}</dd>
            </div>
            <div class="flex justify-between gap-4 border-b border-line py-3">
              <dt class="meta">Services</dt>
              <dd class="max-w-[18rem] text-right text-sm text-text">{person.engagements}</dd>
            </div>
            <div class="flex justify-between gap-4 border-b border-line py-3">
              <dt class="meta">Experience</dt>
              <dd class="text-right text-sm text-text">{person.yearsActive} years, since July 2022</dd>
            </div>
          </dl>
        </div>
      </div>

      <div class="resume-actions resume-screen-only mt-9 flex flex-wrap gap-3">
        <a class="btn btn-primary" href={`mailto:${person.email}`}>
          <Icon name="mail" class="h-4 w-4" />
          Email {person.shortName}
        </a>
        <button class="btn btn-ghost" type="button" data-print-resume>Print or save as PDF</button>
      </div>
    </header>

    <div class="shell mt-14 grid gap-12 border-t border-line pt-12 lg:grid-cols-12 lg:gap-16">
      <div class="space-y-12 lg:col-span-8">
        <section aria-labelledby="experience-heading">
          <p class="meta mb-3">Experience</p>
          <h2 id="experience-heading" class="display-tight text-3xl">Where I have worked</h2>
          <ol class="mt-7 border-t border-line">
            {
              experience.map((role) => (
                <li class="border-b border-line py-6">
                  <div class="flex flex-wrap items-baseline justify-between gap-3">
                    <h3 class="display-tight text-xl">{role.title}</h3>
                    <span class="meta">{role.period}</span>
                  </div>
                  <p class="mt-1 text-sm text-text">{role.organization}</p>
                  <ul class="resume-bullets mt-3 max-w-[65ch] space-y-1.5 leading-relaxed text-text-dim">
                    {role.highlights.map((item) => <li>{item}</li>)}
                  </ul>
                </li>
              ))
            }
          </ol>
        </section>

        <section aria-labelledby="work-heading">
          <p class="meta mb-3">Selected work</p>
          <h2 id="work-heading" class="display-tight text-3xl">Systems I have built</h2>
          <ol class="mt-7 border-t border-line">
            {
              selected.map((entry) => (
                <li class="border-b border-line py-6">
                  <div class="flex flex-wrap items-baseline justify-between gap-3">
                    <h3 class="display-tight text-xl">{entry.data.shortTitle}</h3>
                    <span class="meta">{entry.data.sector} · {entry.data.category === "Mobile" ? "Android and iOS" : entry.data.category}</span>
                  </div>
                  <p class="mt-3 max-w-[65ch] leading-relaxed text-text-dim">{entry.data.summary}</p>
                  <p class="mt-3 text-sm text-text">
                    <strong>Role:</strong> {entry.data.role}
                  </p>
                  <a class="resume-screen-only link tap-target mt-3 inline-flex" href={`/work/${entry.id}`}>
                    Read the case study
                  </a>
                </li>
              ))
            }
          </ol>
        </section>

        <section aria-labelledby="service-heading">
          <p class="meta mb-3">Scope</p>
          <h2 id="service-heading" class="display-tight text-3xl">Work I can own</h2>
          <ul class="mt-7 grid gap-5 sm:grid-cols-2">
            {
              services.map((service) => (
                <li class="border-t border-line pt-4">
                  <h3 class="font-medium text-text">{service.name}</h3>
                  <p class="mt-2 text-sm leading-relaxed text-text-dim">{service.description}</p>
                </li>
              ))
            }
          </ul>
        </section>
      </div>

      <aside class="space-y-10 lg:col-span-4">
        <section aria-labelledby="skills-heading" class="plate p-6 lg:p-8">
          <p class="meta mb-3">Key competencies</p>
          <h2 id="skills-heading" class="display-tight text-xl">Skills</h2>
          <dl class="mt-5 space-y-4">
            {
              skillGroups.map((group) => (
                <div>
                  <dt class="text-sm font-medium text-text">{group.name}</dt>
                  <dd class="mt-1 text-sm leading-relaxed text-text-dim">{group.items.join(", ")}</dd>
                </div>
              ))
            }
          </dl>
        </section>

        <section aria-labelledby="education-heading">
          <p class="meta mb-3">Education</p>
          <h2 id="education-heading" class="display-tight text-xl">Degree</h2>
          <p class="mt-5 text-sm font-medium text-text">{education.degree}</p>
          <p class="mt-1 text-sm text-text-dim">{education.school} · {education.period}</p>
        </section>

        <section aria-labelledby="cert-heading">
          <p class="meta mb-3">Certifications</p>
          <h2 id="cert-heading" class="display-tight text-xl">Credentials</h2>
          <ul class="mt-5 space-y-4">
            {
              certifications.map((cert) => (
                <li class="text-sm">
                  <p class="font-medium text-text">{cert.name}</p>
                  <p class="mt-1 text-text-dim">{cert.issuer} · {cert.period}</p>
                </li>
              ))
            }
          </ul>
        </section>

        <section aria-labelledby="contact-heading">
          <p class="meta mb-3">Direct contact</p>
          <h2 id="contact-heading" class="display-tight text-xl">Profiles and contact</h2>
          <ul class="mt-5 space-y-3 text-sm">
            <li><a class="link" href={`mailto:${person.email}`}>{person.email}</a></li>
            <li><a class="link" href={`tel:${person.phoneE164}`}>{person.phone}</a></li>
            <li>
              <a class="link inline-flex items-center gap-2" href={person.github} rel="me">
                <BrandIcon name="github" class="h-4 w-4" /> GitHub
              </a>
            </li>
            <li>
              <a class="link inline-flex items-center gap-2" href={person.linkedin} rel="me">
                <BrandIcon name="linkedin" class="h-4 w-4" /> LinkedIn
              </a>
            </li>
          </ul>
        </section>
      </aside>
    </div>
  </article>
</BaseLayout>

<style>
  .resume-bullets { list-style: disc; padding-left: 1.1rem; }
  .resume-bullets li::marker { color: var(--accent); }
</style>

<script>
  document.querySelector<HTMLButtonElement>("[data-print-resume]")?.addEventListener("click", () => {
    window.print();
  });
</script>

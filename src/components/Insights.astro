---
import type { CollectionEntry } from "astro:content";
import Icon from "./Icon.astro";
interface Props { entries: CollectionEntry<"insights">[]; }
const { entries } = Astro.props;
---

<section id="insights" class="section rule-top" aria-labelledby="insights-heading">
  <div class="shell">
    <header class="notes-header">
      <div><p class="meta notes-label">07 / Notes</p><h2 id="insights-heading" class="display notes-heading">Behind the decisions.</h2></div>
      <a href="/insights" class="link tap-target notes-all">All engineering notes <Icon name="arrow-up-right" class="h-4 w-4" /></a>
    </header>
    <p class="notes-intro">The data, access and AI decisions behind the published work.</p>
    <ol class="notes-list">
      {entries.map((entry, index) => (
        <li>
          <a href={`/insights/${entry.id}`} class="notes-link">
            <span class="meta notes-number">{String(index + 1).padStart(2, "0")}</span>
            <span class="notes-title display-tight">{entry.data.title}</span>
            <span class="notes-summary">{entry.data.summary}</span>
            <span class="notes-arrow"><Icon name="arrow-up-right" class="h-5 w-5" /></span>
          </a>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .notes-header { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1.5rem; align-items: end; }
  .notes-label { margin-bottom: 1.75rem; color: var(--accent); }
  .notes-heading { font-size: clamp(2.5rem, 5vw, 4.5rem); line-height: 1; }
  .notes-all { display: inline-flex; align-items: center; gap: .75rem; font-size: .8rem; }
  .notes-intro { color: var(--text-dim); margin-top: 1.5rem; max-width: 55ch; line-height: 1.7; }
  .notes-list { margin-top: 2.5rem; border-top: 1px solid var(--line-strong); }
  .notes-link { display: grid; grid-template-columns: 1.5rem 1fr 2rem; align-items: start; gap: 1rem; padding-block: 1.75rem; border-bottom: 1px solid var(--line); }
  .notes-number { padding-top: .25rem; }
  .notes-title { font-size: clamp(1.3rem, 2vw, 1.7rem); line-height: 1.15; transition: color 180ms ease; }
  .notes-summary { grid-column: 2; color: var(--text-dim); font-size: .85rem; line-height: 1.65; }
  .notes-arrow { grid-column: 3; grid-row: 1; color: var(--accent); padding-top: .2rem; }
  .notes-link:hover .notes-title { color: var(--accent); }
  @media (min-width: 1000px) {
    .notes-link { grid-template-columns: 2rem 1.2fr 1fr 2rem; gap: 2rem; align-items: center; padding-block: 2rem; }
    .notes-summary { grid-column: 3; }
    .notes-arrow { grid-column: 4; }
  }
</style>

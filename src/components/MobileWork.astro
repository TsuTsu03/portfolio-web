---
import { Picture } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import Icon from "./Icon.astro";
interface Props { entries: CollectionEntry<"work">[] }
const { entries } = Astro.props;
---
<section id="mobile" class="section rule-top mobile-section" aria-labelledby="mobile-heading">
  <div class="shell">
    <div class="section-heading-row">
      <div><p class="section-label">03 / Mobile applications</p><h2 id="mobile-heading" class="display">Built for the<br /><span class="heading-muted">phone in hand.</span></h2></div>
      <p class="section-intro">Android and iOS apps written with React Native and Expo, and with Flutter and Dart. Real camera work, on-device storage and behaviour that survives a dead signal.</p>
    </div>
    <div class="mobile-toolbar">
      <ul class="mobile-stacks" aria-label="Mobile frameworks">
        <li>React Native · Expo</li>
        <li>Flutter · Dart</li>
      </ul>
      <p class="mobile-count"><span>{String(entries.length).padStart(2, "0")}</span> apps</p>
    </div>
    <div class="mobile-carousel" data-mobile-carousel>
      <div class="mobile-stage">
        <ul
          id="mobile-track"
          class="mobile-track"
          data-carousel-track
          tabindex="0"
          aria-roledescription="carousel"
          aria-label="Mobile app projects. Scroll sideways to browse."
        >
          {entries.map((entry, index) => (
            <li class="mobile-card" data-carousel-slide data-carousel-title={entry.data.shortTitle}>
              <a href={`/work/${entry.id}`} class="mobile-card-link">
                <div class="mobile-shot">
                  <span class="mobile-edition" aria-hidden="true">{String(index + 1).padStart(2, "0")} / {entry.data.shortTitle}</span>
                  <Picture src={entry.data.screenshot} alt={entry.data.screenshotAlt} widths={[480, 800, 1200]} sizes="(min-width: 1000px) 670px, 85vw" formats={["avif", "webp"]} fallbackFormat="webp" loading="lazy" />
                  <span class="mobile-platforms" aria-hidden="true">Android · iOS</span>
                </div>
                <div class="mobile-body">
                  <div class="mobile-meta"><span>{entry.data.sector}</span><span>{String(index + 1).padStart(2, "0")}</span></div>
                  <h3>{entry.data.shortTitle}<Icon name="arrow-up-right" class="mobile-arrow h-5 w-5 shrink-0" /></h3>
                  <p>{entry.data.summary}</p>
                  <ul class="mobile-stack" aria-label="Technologies">{entry.data.technologies.slice(0, 3).map((tech) => <li>{tech}</li>)}</ul>
                  <div class="mobile-foot"><span class="mobile-status"><span></span>{entry.data.status}</span><span class="mobile-read">View case study <span aria-hidden="true">↗</span></span></div>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </div>
      <div class="mobile-controls">
        <div class="mobile-nav">
          <button type="button" data-carousel-prev aria-label="Previous app" aria-controls="mobile-track">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M15 5l-7 7 7 7" stroke-linecap="square" /></svg>
          </button>
          <button type="button" data-carousel-next aria-label="Next app" aria-controls="mobile-track">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M9 5l7 7-7 7" stroke-linecap="square" /></svg>
          </button>
        </div>
        <div class="mobile-dots" role="group" aria-label="Jump to an app">
          {entries.map((entry, index) => (
            <button type="button" data-carousel-marker={index} aria-current={index === 0} aria-label={`Show ${entry.data.shortTitle}`}>{entry.data.shortTitle}</button>
          ))}
        </div>
        <p class="mobile-position" role="status" aria-live="polite" data-carousel-status>1 of {entries.length}</p>
      </div>
    </div>
  </div>
</section>
<script>
  import { initCarousel } from "../scripts/carousel";

  const root = document.querySelector<HTMLElement>("[data-mobile-carousel]");
  if (root) initCarousel(root);
</script>
<style>
.mobile-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin: 36px 0 12px; }
  .mobile-stacks { display: flex; flex-wrap: wrap; gap: 10px 24px; list-style: none; padding: 0; margin: 0; }
  .mobile-stacks li { font: 10px/1.6 var(--font-mono); color: var(--text-dim); }
  .mobile-count { color: var(--text-faint); white-space: nowrap; font: 10px var(--font-mono); }
  .mobile-count span { color: var(--text); }

  /* A wide app-screen gallery settles into place above an open editorial caption. */
  .mobile-track { --slide-width: 68%; --slide-gap: 38px; display: flex; gap: var(--slide-gap); padding: 24px 0 32px; margin: 0; list-style: none; overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x mandatory; scrollbar-width: none; }
  .mobile-track::-webkit-scrollbar { display: none; }
  .mobile-track::before, .mobile-track::after { content: ""; flex: 0 0 calc((100% - var(--slide-width)) / 2); }
  .mobile-track::before { margin-right: calc(-1 * var(--slide-gap)); }
  .mobile-track::after { margin-left: calc(-1 * var(--slide-gap)); }
  .mobile-track:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .mobile-card { min-width: 0; flex: 0 0 var(--slide-width); scroll-snap-align: center; }
  .mobile-card-link { display: block; height: 100%; }
  .mobile-shot { position: relative; padding: 50px 24px 42px; overflow: hidden; border: 1px solid var(--line-strong); border-radius: 22px; background: var(--ink-deep); transform: translateY(calc(var(--slide-distance, 0) * 16px)) scale(calc(1 - var(--slide-distance, 0) * .055)); transition: border-color 250ms, box-shadow 350ms; }
  .mobile-card[data-active="true"] .mobile-shot { border-color: var(--accent-edge); box-shadow: 0 22px 40px -28px var(--hero-shadow); }
  .mobile-shot :global(picture) { display: block; overflow: hidden; border-radius: 8px; }
  .mobile-shot :global(img) { display: block; width: 100%; height: auto; aspect-ratio: 8/5; object-fit: contain; transition: transform 700ms cubic-bezier(.22,1,.36,1); }
  .mobile-edition { position: absolute; top: 22px; left: 26px; color: var(--text-dim); font: 10px var(--font-mono); letter-spacing: .08em; text-transform: uppercase; }
  .mobile-platforms { position: absolute; bottom: 17px; right: 26px; color: var(--text-faint); font: 9px var(--font-mono); letter-spacing: .08em; }
  .mobile-body { padding: 26px 6px 0; display: grid; grid-template-columns: 1fr 1.2fr; gap: 0 40px; }
  .mobile-meta { grid-column: 1; display: flex; gap: 18px; align-items: center; color: var(--accent); font: 10px var(--font-mono); text-transform: uppercase; letter-spacing: .06em; }
  .mobile-meta > span:last-child { display: none; }
  .mobile-body h3 { grid-column: 1; grid-row: 2; display: flex; align-items: center; gap: 22px; margin-top: 12px; font: 650 clamp(2rem, 4vw, 3.6rem)/1.05 var(--font-display); letter-spacing: -.045em; }
  :global(.mobile-arrow) { width: 23px; height: 23px; flex-shrink: 0; color: var(--accent); transition: transform 250ms; }
  .mobile-body > p { grid-column: 2; grid-row: 1/4; font-size: 14px; line-height: 1.8; color: var(--text-dim); }
  .mobile-stack { grid-column: 1; display: flex; flex-wrap: wrap; gap: 7px 12px; list-style: none; padding: 0; margin: 18px 0 22px; font: 9px/1.6 var(--font-mono); color: var(--text-faint); }
  .mobile-foot { grid-column: 1/-1; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; padding-top: 18px; border-top: 1px solid var(--line); font-size: 11px; }
  .mobile-status { display: flex; align-items: center; gap: 7px; color: var(--text-dim); }
  .mobile-status > span { width: 4px; height: 4px; border-radius: 50%; background: var(--accent); }
  .mobile-read { display: flex; gap: 14px; color: var(--accent); }
  .mobile-controls { display: flex; align-items: center; justify-content: center; gap: 22px; margin-top: 6px; }
  .mobile-nav { display: contents; }
  .mobile-nav button { display: grid; place-items: center; width: 48px; height: 48px; flex-shrink: 0; border: 1px solid var(--line-control); border-radius: 50%; background: var(--surface); color: var(--text); cursor: pointer; transition: background 200ms, border-color 200ms, transform 200ms; }
  .mobile-nav button:first-child { order: 0; }
  .mobile-nav button:last-child { order: 2; }
  .mobile-nav button:disabled { opacity: .35; cursor: default; }
  .mobile-nav svg { width: 18px; height: 18px; }
  .mobile-dots { order: 1; display: flex; gap: 4px; padding: 4px; border: 1px solid var(--line-strong); border-radius: 30px; background: var(--surface); }
  .mobile-dots button { min-height: 44px; padding: 10px 24px; border-radius: 24px; font-size: 12px; color: var(--text-dim); cursor: pointer; transition: color 200ms, background 250ms; }
  .mobile-dots button[aria-current="true"] { background: var(--accent); color: var(--on-accent); }
  .mobile-position { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  .mobile-carousel:not([data-carousel-ready]) .mobile-controls { display: none; }
  @media (hover: hover) and (pointer: fine) {
    .mobile-card-link:hover .mobile-shot { border-color: var(--accent); }
    .mobile-card-link:hover :global(img) { transform: translateY(-5px); }
    .mobile-card-link:hover :global(.mobile-arrow) { transform: translate(3px,-3px); }
    .mobile-nav button:hover:not(:disabled) { border-color: var(--accent); background: var(--accent-wash); transform: translateY(-2px); }
  }
  @media (max-width: 1000px) { .mobile-track { --slide-width: 80%; --slide-gap: 26px; } .mobile-body { gap: 0 26px; } }
  @media (max-width: 640px) { .mobile-track { --slide-width: 90%; --slide-gap: 20px; padding-top: 18px; } .mobile-toolbar { align-items: flex-start; margin-top: 28px; } .mobile-stacks { gap: 7px; flex-direction: column; } .mobile-shot { padding: 42px 10px 34px; border-radius: 16px; } .mobile-edition { top: 18px; left: 18px; font-size: 9px; } .mobile-platforms { right: 18px; bottom: 13px; font-size: 8px; } .mobile-body { display: flex; flex-direction: column; padding: 22px 2px 0; } .mobile-body h3 { margin-top: 10px; justify-content: space-between; } .mobile-body > p { margin-top: 16px; font-size: 13px; } .mobile-stack { margin-block: 18px; } .mobile-controls { gap: 12px; } .mobile-dots button { padding-inline: 18px; } }
  @media (max-width: 359px) { .mobile-controls { gap: 8px; } .mobile-dots button { padding-inline: 12px; } .mobile-nav button { width: 44px; height: 44px; } }
  @media (prefers-reduced-motion: reduce) { .mobile-shot, .mobile-shot :global(img), :global(.mobile-arrow), .mobile-nav button, .mobile-dots button { transform: none !important; transition: none; } }
</style>

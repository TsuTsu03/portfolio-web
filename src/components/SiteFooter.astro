---
import { navItems, person, SITE_UPDATED } from "../data/site";

const year = new Date().getFullYear();
---

<footer class="border-t border-line py-10">
  <div class="shell flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
    <p class="text-sm text-text-dim">
      © {year} {person.name}. Built with Astro. Last reviewed <time datetime={SITE_UPDATED}>{SITE_UPDATED}</time>.
    </p>

    <nav aria-label="Footer">
      <ul class="flex flex-wrap gap-x-6 gap-y-2">
        {
          navItems.map((item) => (
            <li>
              <a
                href={`/#${item.id}`}
                class="text-sm text-text-dim transition-colors hover:text-text"
                aria-label={`${item.label}: ${item.accessibleName}`}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</footer>

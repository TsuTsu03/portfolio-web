---
import BrandIcon from "./BrandIcon.astro";
import Icon from "./Icon.astro";
import { person } from "../data/site";
---

<section id="contact" class="section rule-top contact-section" aria-labelledby="contact-heading">
  <div class="shell">
    <div class="contact-topline"><p class="meta">08 / Contact</p><p class="meta">{person.locality} · Remote worldwide</p></div>
    <div class="contact-grid">
      <div>
        <h2 id="contact-heading" class="display contact-heading">Let's build<br />what's next<span>.</span></h2>
        <p class="contact-description">A new product, a difficult workflow, or a system ready for its next chapter. Tell me what you have in mind.</p>
      </div>
      <div class="contact-actions">
        <p class="meta">Start a conversation</p>
        <a href={`mailto:${person.email}`} class="contact-primary">
          <span>Write to me<span class="contact-address">{person.email}</span></span>
          <Icon name="arrow-up-right" class="h-6 w-6 shrink-0" />
        </a>
        <a href={`tel:${person.phoneE164}`} class="link tap-target contact-phone">Call {person.phone}</a>
        <p class="contact-reply">Usually replies within one business day.<br />{person.timezone}</p>
      </div>
    </div>
    <div class="contact-bottom">
      <p class="contact-fit">{person.engagements}</p>
      <nav aria-label="Social profiles" class="contact-socials">
        <a href={person.github} class="link tap-target" target="_blank" rel="noopener noreferrer me"><BrandIcon name="github" class="h-4 w-4" />GitHub</a>
        <a href={person.linkedin} class="link tap-target" target="_blank" rel="noopener noreferrer me"><BrandIcon name="linkedin" class="h-4 w-4" />LinkedIn</a>
        <a href={person.instagram} class="link tap-target" target="_blank" rel="noopener noreferrer me"><BrandIcon name="instagram" class="h-4 w-4" />Instagram</a>
      </nav>
    </div>
  </div>
</section>

<style>
  .contact-topline { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .75rem; }
  .contact-topline > :first-child { color: var(--accent); }
  .contact-grid { display: grid; gap: 2.5rem; padding-block: 3rem; align-items: center; }
  .contact-heading { font-size: clamp(3.5rem, 8vw, 7.5rem); line-height: .95; letter-spacing: -.055em; }
  .contact-heading > span { color: var(--accent); }
  .contact-description { margin-top: 1.75rem; max-width: 43ch; color: var(--text-dim); line-height: 1.7; }
  .contact-actions > .meta { margin-bottom: 1rem; }
  .contact-primary { display: flex; align-items: center; justify-content: space-between; gap: 1.25rem; background: var(--accent); color: var(--on-accent); padding: 1.3rem 1.5rem; font-size: 1.3rem; font-weight: 650; transition: background-color 180ms ease; }
  .contact-primary:hover { background: var(--text); }
  .contact-address { display: block; font-size: .75rem; margin-top: .25rem; font-weight: 500; overflow-wrap: anywhere; }
  .contact-phone { display: inline-flex; gap: .6rem; align-items: center; margin-top: 1rem; font-size: .9rem; }
  .contact-reply { font-size: .8rem; color: var(--text-dim); margin-top: 1rem; line-height: 1.6; }
  .contact-bottom { display: flex; flex-wrap: wrap; gap: 1.5rem; justify-content: space-between; border-top: 1px solid var(--line-strong); padding-top: 1.5rem; align-items: center; }
  .contact-fit { font-size: .85rem; color: var(--text-dim); }
  .contact-socials { display: flex; flex-wrap: wrap; gap: 1.5rem; }
  .contact-socials a { display: inline-flex; align-items: center; gap: .5rem; font-size: .8rem; }
  @media (min-width: 900px) { .contact-grid { grid-template-columns: 1.5fr 1fr; gap: 5rem; padding-block: 4rem; } }
</style>

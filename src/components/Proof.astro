---
import Icon from "./Icon.astro";
import { person, resumeUrl } from "../data/site";

interface Props {
  projectCount: number;
  liveCount: number;
  repoCount: number;
  /** Date every deployment link was last checked. */
  verified: string;
  verifiedIso: string;
}
const { projectCount, liveCount, repoCount, verified, verifiedIso } = Astro.props;
const figures = [
  { value: person.yearsActive, label: "Years building web systems" },
  { value: String(projectCount), label: "Documented builds" },
  { value: String(liveCount), label: "Linked live deployments" },
  { value: String(repoCount), label: "Public repositories" },
];
---

<section id="proof" class="rule-top proof-section" aria-labelledby="proof-heading">
  <div class="shell">
    <div class="proof-top">
      <h2 id="proof-heading" class="meta">A record you can inspect</h2>
      {resumeUrl ? <a href={resumeUrl} class="link tap-target proof-resume">Read my résumé <Icon name="arrow-up-right" class="h-4 w-4" /></a> : <a href={`mailto:${person.email}`} class="link tap-target proof-resume">Request my résumé <Icon name="arrow-up-right" class="h-4 w-4" /></a>}
    </div>
    <dl class="proof-figures">
      {figures.map((figure) => (
        <div><dt>{figure.label}</dt><dd class="display">{figure.value}</dd></div>
      ))}
    </dl>
    <div class="proof-bottom">
      <p>Independent and client work. Each case study names my contribution.</p>
      <p>Deployment links checked <time datetime={verifiedIso}>{verified}</time>. Career Path is no longer hosted.</p>
    </div>
  </div>
</section>

<style>
  .proof-section { padding-block: 2rem; }
  .proof-top { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1rem; }
  .proof-top h2 { color: var(--accent); }
  .proof-resume { display: inline-flex; align-items: center; gap: .75rem; font-size: .8rem; }
  .proof-figures { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem; margin-block: 2rem; }
  .proof-figures > div { display: flex; flex-direction: column-reverse; align-items: flex-start; }
  .proof-figures dt { font-size: .8rem; margin-top: .8rem; color: var(--text-dim); }
  .proof-figures dd { font-size: clamp(2.75rem, 5vw, 4.25rem); }
  .proof-bottom { display: grid; gap: .5rem; border-top: 1px solid var(--line); padding-top: 1rem; color: var(--text-faint); font-size: .7rem; line-height: 1.6; }
  @media (min-width: 768px) {
    .proof-figures { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0; }
    .proof-figures > div + div { padding-left: 2rem; border-left: 1px solid var(--line); }
    .proof-bottom { grid-template-columns: 1fr 1fr; gap: 2rem; }
    .proof-bottom > :last-child { text-align: right; }
  }
</style>

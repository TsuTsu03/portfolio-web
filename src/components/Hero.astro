---
import { Picture } from "astro:assets";
import Icon from "./Icon.astro";
import { person, resumeUrl } from "../data/site";
import skyline from "../assets/brand/gotham-night.png";
interface Props { projectCount: number; agentCount: number }
const { projectCount, agentCount } = Astro.props;
---
<section id="identity" class="night-hero" aria-labelledby="identity-heading">
  <div class="night-scene" aria-hidden="true">
    <Picture src={skyline} alt="" widths={[768, 1280, 1920]} sizes="100vw" formats={["avif", "webp"]} fallbackFormat="webp" loading="eager" fetchpriority="high" />
  </div>
  <div class="shell night-composition">
    <div class="night-intro">
      <p class="night-eyebrow"><span></span> Software engineering &amp; applied AI</p>
      <h1 id="identity-heading" class="night-name">Den Jansen <span>Flores<span class="name-period">.</span></span></h1>
      <p class="night-profession">{person.role}<br /><span>{person.secondRole}</span></p>
      <p class="night-description">I turn complex workflows into software people can rely on. From the first database table to the last detail on screen.</p>
      <div class="night-actions">
        <a href="#work" class="btn btn-primary">Explore my work <Icon name="arrow-right" class="h-4 w-4" /></a>
        <a href={resumeUrl} class="night-resume">View résumé <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <div class="night-caption" aria-hidden="true"><span>After dark. In focus.</span><span>THE DENFORGE PORTFOLIO / 2026</span></div>
    <div class="night-bottom">
      <a href="#contact" class="night-availability"><span class="availability-dot"></span><span>{person.availability}<small>{person.region}, PH · {person.timezone}</small></span><span aria-hidden="true">↗</span></a>
      <dl class="night-facts">
        <div><dt>Years building</dt><dd>{person.yearsActive}</dd></div>
        <div><dt>Case studies</dt><dd>{String(projectCount).padStart(2, "0")}</dd></div>
        <div><dt>Agent demos</dt><dd>{String(agentCount).padStart(2, "0")}</dd></div>
      </dl>
      <a href="#work" class="night-scroll" aria-label="Scroll to selected projects"><span>Scroll to explore</span><span aria-hidden="true">↓</span></a>
    </div>
  </div>
</section>
<style>
  .night-hero{position:relative;isolation:isolate;min-height:min(920px,100svh);background:#090b0c;color:#f0eee7;overflow:hidden}
  .night-scene{position:absolute;inset:60px 0 0;z-index:-2}
  .night-scene :global(picture),.night-scene :global(img){width:100%;height:100%;object-fit:cover;object-position:65% top}
  .night-scene::after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,#090b0c73,transparent 80%),linear-gradient(0deg,#090b0c,transparent 32%)}
  .night-composition{min-height:min(920px,100svh);display:flex;flex-direction:column;position:relative;padding-top:clamp(140px,18vh,200px)}
  .night-intro{max-width:760px;padding-bottom:85px}
  .night-eyebrow{display:flex;align-items:center;gap:13px;font-family:var(--font-mono);font-size:10px;letter-spacing:.19em;text-transform:uppercase;color:#d7b46a;margin-bottom:30px}
  .night-eyebrow>span{width:24px;height:1px;background:currentColor}
  .night-name{font-family:var(--font-display);font-variation-settings:"wdth" 78;font-weight:750;font-size:clamp(4rem,7.6vw,7.4rem);line-height:.91;letter-spacing:-.055em;text-transform:uppercase;margin-left:-.035em}
  .night-name>span{display:block;color:#d7b46a}.name-period{color:#f0eee7}
  .night-profession{font-size:clamp(1rem,1.35vw,1.2rem);line-height:1.6;margin-top:30px;font-weight:550}.night-profession>span{color:#c4c5c4}
  .night-description{font-size:15px;line-height:1.75;max-width:43ch;color:#b8bcbf;margin-top:16px}
  .night-actions{display:flex;align-items:center;gap:28px;margin-top:30px}.night-actions .btn{background:#d7b46a;color:#10110e;border-color:#d7b46a;font-size:13px;gap:25px;min-height:50px}.night-actions .btn:hover{background:#edcc8b}
  .night-resume{display:flex;gap:20px;align-items:center;min-height:44px;font-size:13px;color:#e0dfd9}.night-resume:hover{color:#d7b46a}
  .night-caption{position:absolute;right:var(--gutter);top:61%;text-align:right;display:grid;gap:10px;color:#d5d5cc;text-shadow:0 1px 10px #000}.night-caption span:first-child{font-size:12px;font-style:italic}.night-caption span:last-child{font-family:var(--font-mono);font-size:8px;letter-spacing:.14em;color:#acb0b0}
  .night-bottom{margin-top:auto;padding:27px 0 28px;border-top:1px solid #ffffff26;display:flex;align-items:center;justify-content:space-between;gap:30px}
  .night-availability{display:flex;gap:13px;align-items:center;font-size:12px}.night-availability small{display:block;color:#9da6ab;font-size:10px;margin-top:6px}.night-availability>span:last-child{margin-left:15px;color:#d7b46a}.availability-dot{height:6px;width:6px;background:#d7b46a;border-radius:50%;box-shadow:0 0 0 4px #d7b46a15}
  .night-facts{display:flex;gap:45px}.night-facts>div{display:flex;flex-direction:column-reverse;gap:4px}.night-facts dd{font-size:26px;font-family:var(--font-display);line-height:1;font-weight:550}.night-facts dt{font-size:9px;text-transform:uppercase;letter-spacing:.09em;color:#9da6ab}
  .night-scroll{display:flex;align-items:center;gap:22px;font-family:var(--font-mono);font-size:9px;text-transform:uppercase;letter-spacing:.1em;color:#aeb3b6}.night-scroll>span:last-child{font-size:24px;color:#d7b46a}
  @media(max-width:1000px){.night-caption,.night-scroll{display:none}.night-name{font-size:clamp(4rem,9vw,6rem)}.night-scene::after{background:linear-gradient(90deg,#090b0cb3,#090b0c0d),linear-gradient(0deg,#090b0c,transparent 60%)}}
  @media(max-width:640px){.night-hero,.night-composition{min-height:max(800px,100svh)}.night-composition{padding-top:145px}.night-intro{padding-bottom:55px}.night-name{font-size:clamp(3.3rem,13vw,5rem)}.night-eyebrow{font-size:8px;letter-spacing:.12em;margin-bottom:26px;gap:8px}.night-profession{font-size:14px}.night-description{font-size:14px;max-width:34ch}.night-actions{gap:22px}.night-actions .btn{padding-inline:16px;font-size:12px;gap:18px}.night-resume{font-size:12px;gap:10px}.night-scene :global(img){object-position:70% center}.night-scene::after{background:linear-gradient(90deg,#090b0ced,#090b0c45),linear-gradient(0deg,#090b0c,transparent 80%)}.night-bottom{align-items:flex-start;flex-direction:column;gap:25px;padding-top:22px}.night-facts{width:100%;justify-content:space-between;gap:20px}.night-facts dd{font-size:24px}.night-facts dt{font-size:8px}.night-availability{font-size:11px}.night-availability small{font-size:9px}}
  @media(max-width:359px){.night-actions{gap:18px}.night-actions .btn{font-size:11px;padding-inline:12px;gap:12px;white-space:nowrap}.night-resume{font-size:11px;gap:6px;white-space:nowrap}}
  @media(forced-colors:active){.night-scene{display:none}.night-hero,.night-name>span,.night-profession>span,.night-description{color:CanvasText;background:Canvas}.night-eyebrow,.night-resume,.night-availability,.night-facts dt{color:CanvasText}}
</style>

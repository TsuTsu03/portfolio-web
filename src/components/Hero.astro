---
import Icon from "./Icon.astro";
import { person } from "../data/site";
interface Props { projectCount: number; agentCount: number }
const { projectCount, agentCount } = Astro.props;
---
<section id="identity" class="night-hero" aria-labelledby="identity-heading">
  <div class="night-architecture" aria-hidden="true">
    <span class="night-light-pass"></span>
  </div>
  <div class="night-signal" aria-hidden="true">
    <div class="signal-topline"><span>DF / ENGINEERING</span><span>DESIGN / BUILD / REFINE</span></div>
    <svg class="signal-emblem signal-night" viewBox="0 70 600 320" fill="none" focusable="false">
      <defs>
        <linearGradient id="signal-metal" x1="130" y1="130" x2="450" y2="340" gradientUnits="userSpaceOnUse">
          <stop stop-color="#62645d" /><stop offset=".38" stop-color="#292f30" /><stop offset=".7" stop-color="#111719" /><stop offset="1" stop-color="#42443b" />
        </linearGradient>
        <linearGradient id="signal-edge" x1="90" y1="150" x2="490" y2="320" gradientUnits="userSpaceOnUse">
          <stop stop-color="#d7b46a" /><stop offset=".45" stop-color="#7d806f" /><stop offset="1" stop-color="#343b3c" />
        </linearGradient>
      </defs>
      <path class="signal-guide" d="M36 118H564M36 354H564M300 76V388" stroke="#d7b46a" stroke-opacity=".14" stroke-dasharray="2 8" />
      <path class="signal-outline" d="M60 152L175 184L229 162L265 205L274 170L289 193H311L326 170L335 205L371 162L425 184L540 152L475 243L439 235L414 270L375 252L352 291L320 275L300 318L280 275L248 291L225 252L186 270L161 235L125 243Z" fill="url(#signal-metal)" stroke="url(#signal-edge)" stroke-width="1.2" />
      <path d="M60 152L225 218L280 275L265 205L229 162L175 184Z" fill="#a9aa94" fill-opacity=".07" />
      <path d="M540 152L375 218L320 275L335 205L371 162L425 184Z" fill="#090d10" fill-opacity=".5" />
      <path d="M60 152L225 218L300 318L375 218L540 152M225 218L265 205M375 218L335 205M300 204V318" stroke="url(#signal-edge)" stroke-opacity=".36" />
      <path d="M36 132V118H50M550 118H564V132M36 340V354H50M550 354H564V340" stroke="#d7b46a" stroke-opacity=".65" />
    </svg>
    <svg class="signal-emblem signal-day" viewBox="0 70 600 320" fill="none" focusable="false">
      <path d="M36 118H564M36 354H564M124 86V386M476 86V386" stroke="var(--line)" />
      <path d="M152 110H448V354H152Z" fill="var(--ink-deep)" />
      <path d="M140 98H436V342H140Z" fill="var(--surface)" stroke="var(--line-strong)" />
      <path d="M140 98H436M140 98V342" stroke="var(--accent)" />
      <text class="signal-monogram" x="280" y="274" text-anchor="middle" fill="var(--text)">DF<tspan fill="var(--accent)">.</tspan></text>
      <path d="M172 310H218M358 130H404" stroke="var(--accent)" />
    </svg>
    <div class="signal-caption"><span><span class="signal-night">After dark.<br /><em>In focus.</em></span><span class="signal-day">Clarity.<br /><em>By design.</em></span></span><span>THE DENFORGE PORTFOLIO<br />SOFTWARE / SYSTEMS / AI</span></div>
  </div>
  <div class="shell night-composition">
    <div class="night-intro">
      <p class="night-eyebrow stagger" style="--i:0"><span></span> Software solutions &amp; consulting</p>
      <h1 id="identity-heading" class="night-name stagger" style="--i:1">Den Jansen <span>Flores<span class="name-period">.</span></span></h1>
      <p class="night-profession stagger" style="--i:2">{person.businessRole}<br /><span>Full-stack, mobile &amp; AI engineering for businesses</span></p>
      <p class="night-description stagger" style="--i:3">I help businesses replace slow, manual work with software that fits how they actually run. Custom web platforms, mobile apps and AI automation, plus straight advice on what is worth building.</p>
      <div class="night-actions stagger" style="--i:4">
        <a href="#contact" class="btn btn-primary">Start a project <Icon name="arrow-right" class="h-4 w-4" /></a>
        <a href="#work" class="night-resume">Explore my work <span aria-hidden="true">↓</span></a>
      </div>
    </div>
    <div class="night-bottom stagger" style="--i:5">
      <a href="#contact" class="night-availability"><span class="availability-dot"></span><span>{person.availability}<small>{person.region}, PH · {person.timezone}</small></span><span aria-hidden="true">↗</span></a>
      <dl class="night-facts">
        <div><dt>Years building</dt><dd>{person.yearsActive}</dd></div>
        <div><dt>Case studies</dt><dd>{String(projectCount).padStart(2, "0")}</dd></div>
        <div><dt>Agent demos</dt><dd>{String(agentCount).padStart(2, "0")}</dd></div>
      </dl>
      <a href="#work" class="night-scroll" aria-label="Scroll to selected projects"><span>Scroll to explore</span><span aria-hidden="true">↓</span></a>
    </div>
  </div>
</section>
<style>
  .night-hero{position:relative;isolation:isolate;min-height:min(920px,100svh);color:var(--text);overflow:hidden}
  .night-architecture{position:absolute;inset:0;z-index:-2;overflow:hidden;pointer-events:none}
  .night-light-pass{position:absolute;inset:-50%;opacity:0;background:linear-gradient(110deg,transparent 46%,var(--accent-wash) 50%,transparent 54%);transform:translateX(35%)}
  .night-signal{position:absolute;top:24%;right:max(var(--gutter),calc((100vw - 1440px)/2 + var(--gutter)));width:min(42vw,580px);pointer-events:none}
  .signal-topline{display:flex;justify-content:space-between;gap:16px;border-top:1px solid var(--line);padding-top:14px;font:8px var(--font-mono);letter-spacing:.12em;color:var(--text-faint)}
  .signal-emblem{width:100%;height:auto;overflow:visible;margin-block:24px}
  .signal-day{display:none}
  .signal-monogram{font-family:var(--font-display);font-size:172px;font-weight:600;letter-spacing:-12px}
  :global(:root[data-theme="light"]) .signal-night{display:none}
  :global(:root[data-theme="light"]) .signal-day{display:block}
  .signal-caption{display:flex;align-items:end;justify-content:space-between;gap:16px;padding:0 5%}
  .signal-caption>span:first-child{font:500 clamp(20px,2vw,28px)/1.3 var(--font-display);letter-spacing:-.025em;color:var(--text)}.signal-caption em{font-style:normal;color:var(--accent)}
  .signal-caption>span:last-child{font:8px/1.8 var(--font-mono);letter-spacing:.12em;text-align:right;color:var(--text-faint)}
  .night-composition{min-height:min(920px,100svh);display:flex;flex-direction:column;position:relative;padding-top:clamp(140px,18vh,200px)}
  .night-intro{max-width:760px;padding-bottom:85px}
  .night-eyebrow{display:flex;align-items:center;gap:13px;font-family:var(--font-mono);font-size:10px;letter-spacing:.19em;text-transform:uppercase;color:var(--accent);margin-bottom:30px}
  .night-eyebrow>span{width:24px;height:1px;background:currentColor}
  .night-name{color:var(--text);font-family:var(--font-display);font-variation-settings:"wdth" 78;font-weight:750;font-size:clamp(4rem,7.6vw,7.4rem);line-height:.91;letter-spacing:-.055em;text-transform:uppercase;margin-left:-.035em}
  .night-name>span{display:block;color:var(--accent)}.name-period{color:var(--text)}
  .night-profession{font-size:clamp(1rem,1.35vw,1.2rem);line-height:1.6;margin-top:30px;font-weight:550}.night-profession>span{color:var(--text-dim)}
  .night-description{font-size:15px;line-height:1.75;max-width:43ch;color:var(--text-dim);margin-top:16px}
  .night-actions{display:flex;align-items:center;gap:28px;margin-top:30px}.night-actions .btn{background:var(--accent);color:var(--on-accent);border-color:var(--accent);font-size:13px;gap:25px;min-height:50px}.night-actions .btn:hover{background:var(--btn-primary-hover)}
  .night-resume{display:flex;gap:20px;align-items:center;min-height:44px;font-size:13px;color:var(--text)}.night-resume:hover{color:var(--accent)}
  .night-bottom{margin-top:auto;padding:27px 0 28px;border-top:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;gap:30px}
  .night-availability{display:flex;gap:13px;align-items:center;font-size:12px}.night-availability small{display:block;color:var(--text-dim);font-size:10px;margin-top:6px}.night-availability>span:last-child{margin-left:15px;color:var(--accent)}.availability-dot{height:6px;width:6px;background:var(--accent);border-radius:50%;box-shadow:0 0 0 4px var(--accent-wash)}
  .night-facts{display:flex;gap:45px}.night-facts>div{display:flex;flex-direction:column-reverse;gap:4px}.night-facts dd{font-size:26px;font-family:var(--font-display);line-height:1;font-weight:550}.night-facts dt{font-size:9px;text-transform:uppercase;letter-spacing:.09em;color:var(--text-dim)}
  .night-scroll{display:flex;align-items:center;gap:22px;font-family:var(--font-mono);font-size:9px;text-transform:uppercase;letter-spacing:.1em;color:var(--text-dim)}.night-scroll>span:last-child{font-size:24px;color:var(--accent)}
  @media(prefers-reduced-motion:no-preference){
    .night-signal{animation:signal-arrive 1200ms var(--ease) 180ms both}
    .signal-outline{stroke-dasharray:1800;stroke-dashoffset:0;animation:signal-trace 1800ms var(--ease) 200ms both}
    .night-light-pass{animation:light-pass 2400ms var(--ease) 300ms both}
    .night-actions .btn :global(svg),.night-resume>span,.night-scroll>span:last-child{transition:transform var(--dur) var(--ease)}
    .night-actions .btn:is(:hover,:focus-visible) :global(svg),.night-resume:is(:hover,:focus-visible)>span{transform:translateX(4px)}
    .night-scroll:is(:hover,:focus-visible)>span:last-child{transform:translateY(5px)}
  }
  @keyframes signal-arrive{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:none}}
  @keyframes signal-trace{from{stroke-dashoffset:1800;fill-opacity:0}to{stroke-dashoffset:0;fill-opacity:1}}
  @keyframes light-pass{0%{opacity:0;transform:translateX(-35%)}35%,65%{opacity:1}100%{opacity:0;transform:translateX(35%)}}
  @media(max-width:1100px){.signal-topline>span:last-child{display:none}.night-signal{width:37vw;top:29%}.signal-caption>span:last-child{display:none}}
  @media(max-width:1000px){.night-scroll{display:none}.night-name{font-size:clamp(4rem,9vw,6rem)}}
  @media(max-width:760px){.night-signal{top:85px;right:var(--gutter);width:120px}.signal-emblem{margin:0}.signal-topline,.signal-caption,.signal-guide{display:none}}
  @media(max-width:640px){.night-hero,.night-composition{min-height:max(800px,100svh)}.night-composition{padding-top:165px}.night-intro{padding-bottom:55px}.night-name{font-size:clamp(3.3rem,13vw,5rem)}.night-eyebrow{font-size:8px;letter-spacing:.12em;margin-bottom:26px;gap:8px}.night-profession{font-size:14px}.night-description{font-size:14px;max-width:34ch}.night-actions{gap:22px}.night-actions .btn{padding-inline:16px;font-size:12px;gap:18px}.night-resume{font-size:12px;gap:10px}.night-bottom{align-items:flex-start;flex-direction:column;gap:25px;padding-top:22px}.night-facts{width:100%;justify-content:space-between;gap:20px}.night-facts dd{font-size:24px}.night-facts dt{font-size:8px}.night-availability{font-size:11px}.night-availability small{font-size:9px}}
  @media(max-width:359px){.night-actions{gap:18px}.night-actions .btn{font-size:11px;padding-inline:12px;gap:12px;white-space:nowrap}.night-resume{font-size:11px;gap:6px;white-space:nowrap}}
  @media(forced-colors:active){.night-architecture,.night-signal{display:none}.night-hero,.night-name,.night-name>span,.night-profession>span,.night-description{color:CanvasText;background:Canvas}.night-eyebrow,.night-resume,.night-availability,.night-facts dt{color:CanvasText}}
</style>

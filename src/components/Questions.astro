---
import Icon from "./Icon.astro";
import { faqs } from "../data/site";
---

<section id="questions" class="section rule-top" aria-labelledby="questions-heading">
  <div class="shell faq-grid">
    <header>
      <p class="meta faq-label">07 / Questions</p>
      <h2 id="questions-heading" class="display faq-heading">Before<br />we begin.</h2>
      <p class="faq-intro">A few things worth knowing about working together.</p>
      <a class="link tap-target faq-contact" href="#contact">Have something else in mind? <Icon name="arrow-right" class="h-4 w-4" /></a>
    </header>
    <div class="faq-list">
      {faqs.map((faq, i) => (
        <details class="disclosure faq-item" open={i === 0}>
          <summary><span>{faq.question}</span><Icon name="plus" class="chev h-4 w-4 shrink-0 text-accent" /></summary>
          <p>{faq.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-grid { display: grid; gap: 2.5rem; }
  .faq-label { color: var(--accent); margin-bottom: 1.75rem; }
  .faq-heading { font-size: clamp(3rem, 5vw, 4.75rem); line-height: .98; }
  .faq-intro { margin-top: 1.5rem; max-width: 28ch; color: var(--text-dim); line-height: 1.7; }
  .faq-contact { display: inline-flex; align-items: center; gap: .75rem; margin-top: 1.5rem; font-size: .8rem; }
  .faq-item { border-top: 1px solid var(--line); }
  .faq-item:last-child { border-bottom: 1px solid var(--line); }
  .faq-item summary { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; padding-block: 1.3rem; font-size: 1rem; font-weight: 550; line-height: 1.5; }
  .faq-item > p { padding: 0 2rem 1.5rem 0; font-size: .9rem; line-height: 1.7; color: var(--text-dim); max-width: 65ch; }
  @media (min-width: 900px) { .faq-grid { grid-template-columns: 1fr 1.65fr; gap: 5rem; } }
</style>

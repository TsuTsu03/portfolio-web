---
import { capabilityGroups, isProven } from "../data/capabilities";
import { services } from "../data/site";
import Icon from "./Icon.astro";
---

<section id="capabilities" class="section rule-top" aria-labelledby="capabilities-heading">
  <div class="shell">
    <header class="cap-intro">
      <div>
        <p class="meta cap-label">05 / Capabilities</p>
        <h2 id="capabilities-heading" class="display cap-heading">From first sketch.<br />To working system.</h2>
      </div>
      <p class="cap-description">One owner across the interface, backend and AI workflow. Explore the services, then inspect the work behind each capability.</p>
    </header>

    <section id="services" aria-labelledby="services-heading" class="service-section">
      <h3 id="services-heading" class="meta">Areas of expertise</h3>
      <ul class="service-grid">
        {services.map((service, index) => (
          <li class="reveal service-item">
            <span class="meta service-number">{String(index + 1).padStart(2, "0")}</span>
            <h4 class="display-tight">{service.name}</h4>
            <p>{service.description}</p>
            <a href={service.path} class="link tap-target service-link">Read more <Icon name="arrow-up-right" class="h-4 w-4" /></a>
          </li>
        ))}
      </ul>
    </section>

    <div class="cap-evidence">
      <div class="cap-evidence-intro">
        <h3 class="display-tight">The tools.<br />The evidence.</h3>
        <p>Every listed skill includes its context. Claims without a public example are marked.</p>
      </div>
      <div class="cap-index">
        {capabilityGroups.map((group) => (
          <details class="disclosure cap-disclosure">
            <summary>
              <span><span class="cap-title">{group.title}</span><span class="cap-role">{group.role}</span></span>
              <Icon name="plus" class="chev h-4 w-4 shrink-0 text-accent" />
            </summary>
            <ul class="cap-items">
              {group.items.map((item) => (
                <li>
                  <p class="cap-item-name">{item.name}</p>
                  <p>{item.proof}</p>
                  {!isProven(item) && <span class="meta cap-proof">Evidence outside this portfolio</span>}
                  {item.provenBy.length > 0 && <span class="meta cap-proof">{item.provenBy.join(", ")}</span>}
                  {item.provenBy.length === 0 && item.thisSite && <span class="meta cap-proof">This site</span>}
                </li>
              ))}
            </ul>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .cap-label { color: var(--accent); margin-bottom: 1.75rem; }
  .cap-intro { display: grid; gap: 1.5rem; align-items: end; }
  .cap-heading { font-size: clamp(2.6rem, 5vw, 4.5rem); line-height: 1; }
  .cap-description { max-width: 42ch; color: var(--text-dim); line-height: 1.7; }
  .service-section { margin-top: 3rem; }
  .service-grid { display: grid; margin-top: 1rem; border-top: 1px solid var(--line-strong); }
  .service-item { display: flex; flex-direction: column; padding: 1.75rem 0; border-bottom: 1px solid var(--line); }
  .service-number { color: var(--accent); }
  .service-item h4 { font-size: 1.5rem; line-height: 1.1; margin-top: 1.5rem; max-width: 20ch; }
  .service-item p { font-size: .9rem; line-height: 1.65; margin-top: 1rem; margin-bottom: 1.5rem; color: var(--text-dim); }
  .service-link { align-self: flex-start; display: inline-flex; gap: .75rem; align-items: center; font-size: .8rem; margin-top: auto; }
  .cap-evidence { display: grid; gap: 2rem; margin-top: 3.5rem; }
  .cap-evidence-intro h3 { font-size: 2rem; line-height: 1.1; }
  .cap-evidence-intro p { margin-top: 1rem; max-width: 32ch; color: var(--text-dim); font-size: .9rem; line-height: 1.65; }
  .cap-disclosure { border-top: 1px solid var(--line); }
  .cap-disclosure:last-child { border-bottom: 1px solid var(--line); }
  .cap-disclosure summary { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; padding-block: 1.3rem; }
  .cap-title { display: block; font-weight: 600; font-size: 1.05rem; }
  .cap-role { display: block; margin-top: .4rem; color: var(--text-dim); font-size: .85rem; line-height: 1.5; }
  .cap-items { display: grid; gap: 1.5rem; padding-bottom: 1.75rem; }
  .cap-items li { border-left: 1px solid var(--line-strong); padding-left: 1rem; font-size: .85rem; color: var(--text-dim); line-height: 1.6; }
  .cap-item-name { color: var(--text); font-weight: 600; margin-bottom: .3rem; }
  .cap-proof { display: block; margin-top: .6rem; font-size: .6rem; }
  @media (min-width: 640px) {
    .service-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .service-item { padding-inline: 1.5rem; border-left: 1px solid var(--line); }
    .service-item:nth-child(odd) { padding-left: 0; border-left: 0; }
    .cap-items { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 1000px) {
    .cap-intro { grid-template-columns: 1.4fr 1fr; gap: 4rem; }
    .service-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .service-item:nth-child(3) { padding-left: 1.5rem; border-left: 1px solid var(--line); }
    .service-item:last-child { padding-right: 0; }
    .cap-evidence { grid-template-columns: 1fr 2fr; gap: 4rem; }
  }
</style>

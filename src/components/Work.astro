---
import { Picture } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import Icon from "./Icon.astro";
interface Props { entries: CollectionEntry<"work">[] }
const { entries } = Astro.props;
const filters = [{ id: "all", label: "All projects" }, { id: "live", label: "Live builds" }, { id: "source", label: "Source available" }];
---
<section id="work" class="section rule-top work-section" aria-labelledby="work-heading">
  <div class="shell">
    <div class="section-heading-row">
      <div><p class="section-label">02 / Web applications</p><h2 id="work-heading" class="display">Built to solve.<br /><span class="heading-muted">Made to work.</span></h2></div>
      <p class="section-intro">Operational web products running in production. A closer look at the software I build, the decisions behind it, and the work I own.</p>
    </div>
    <div class="work-toolbar">
      <div class="work-filters" role="group" aria-label="Filter projects" hidden>
        {filters.map((filter) => <button type="button" data-work-filter={filter.id} aria-pressed={filter.id === "all"}>{filter.label}</button>)}
      </div>
      <p class="work-count" role="status" aria-live="polite"><span data-project-count>{String(entries.length).padStart(2, "0")}</span> projects</p>
    </div>
    <div class="work-carousel" data-work-carousel>
      <div class="work-stage">
        <ul
          id="work-track"
          class="work-track"
          data-carousel-track
          tabindex="0"
          role="group"
          aria-roledescription="carousel"
          aria-label="Web application projects. Scroll sideways to browse."
        >
          {entries.map((entry, index) => (
            <li class="work-card" data-carousel-slide data-work-card data-live={entry.data.status === "Deployed"} data-source={entry.data.repositoryUrl !== null}>
              <a href={`/work/${entry.id}`} class="work-card-link">
                <div class="work-image">
                  <div class="work-image-bar" aria-hidden="true"><span><i></i><i></i><i></i></span><span>{entry.data.shortTitle}</span><span>↗</span></div>
                  <Picture src={entry.data.screenshot} alt={entry.data.screenshotAlt} widths={[480, 800, 1200, 1400]} sizes="(min-width: 1180px) 640px, (min-width: 640px) 62vw, 92vw" formats={["avif", "webp"]} fallbackFormat="webp" loading="lazy" class="work-screenshot" />
                </div>
                <div class="work-content">
                  <div class="work-meta"><span>{entry.data.sector}</span><span>{String(index + 1).padStart(2, "0")}</span></div>
                  <h3>{entry.data.shortTitle}<Icon name="arrow-up-right" class="work-arrow h-5 w-5 shrink-0" /></h3>
                  <p>{entry.data.summary}</p>
                  <ul class="work-stack" aria-label="Technologies">{entry.data.technologies.slice(0, 3).map((tech) => <li>{tech}</li>)}</ul>
                  <div class="work-card-foot"><span class="work-status"><span></span>{entry.data.status}</span><span class="work-read">View case study <span aria-hidden="true">↗</span></span></div>
                </div>
              </a>
            </li>
          ))}
        </ul>
        <div class="work-nav">
          <button type="button" data-carousel-prev aria-label="Previous project" aria-controls="work-track">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M15 5l-7 7 7 7" stroke-linecap="square" /></svg>
          </button>
          <button type="button" data-carousel-next aria-label="Next project" aria-controls="work-track">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M9 5l7 7-7 7" stroke-linecap="square" /></svg>
          </button>
        </div>
      </div>
      <div class="work-controls">
        <div class="work-dots" role="group" aria-label="Jump to a project">
          {entries.map((entry, index) => (
            <button type="button" data-carousel-marker={index} aria-current={index === 0} aria-label={`Show ${entry.data.shortTitle}`}></button>
          ))}
        </div>
        <p class="work-position" role="status" aria-live="polite" data-carousel-status>1 of {entries.length}</p>
      </div>
    </div>
  </div>
</section>
<script>
  import { initCarousel } from "../scripts/carousel";

  const root = document.querySelector<HTMLElement>("[data-work-carousel]");
  const carousel = root ? initCarousel(root) : null;

  const filters = document.querySelector<HTMLElement>(".work-filters");
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-work-filter]"));
  const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-work-card]"));
  const count = document.querySelector("[data-project-count]");

  if (filters && carousel && cards.length) {
    filters.hidden = false;
    buttons.forEach((button) => button.addEventListener("click", () => {
      const filter = button.dataset.workFilter;
      buttons.forEach((item) => item.setAttribute("aria-pressed", String(item === button)));
      cards.forEach((card) => {
        card.hidden = filter === "live" ? card.dataset.live !== "true"
          : filter === "source" ? card.dataset.source !== "true"
          : false;
      });
      if (count) count.textContent = String(cards.filter((card) => !card.hidden).length).padStart(2, "0");
      carousel.refresh();
    }));
  }
</script>
<style>
  .work-section{position:relative}
  .work-toolbar{display:flex;justify-content:space-between;align-items:center;gap:12px;margin:38px 0 25px;padding-bottom:18px;border-bottom:1px solid var(--line)}
  .work-filters:not([hidden]){display:flex;gap:6px;flex-wrap:wrap}.work-filters button{padding:10px 16px;min-height:44px;font-size:12px;color:var(--text-dim);border:1px solid transparent;transition:background 160ms,color 160ms;cursor:pointer}.work-filters button[aria-pressed="true"]{background:var(--accent-wash);border-color:var(--accent-edge);color:var(--accent)}.work-filters button:hover{color:var(--text);border-color:var(--line-control)}
  .work-count{white-space:nowrap;font:10px var(--font-mono);text-transform:uppercase;letter-spacing:.1em;color:var(--text-faint)}.work-count span{color:var(--text)}

  /*
    The track scrolls natively and snaps each card to the centre. The two empty
    pseudo-elements are spacer columns: they let the first and last card reach
    the middle of the viewport like every other one.
  */
  .work-stage{position:relative}
  .work-track{display:grid;grid-auto-flow:column;grid-auto-columns:clamp(320px,52%,660px);list-style:none;margin:0;padding:10px 0 14px;overflow-x:auto;overscroll-behavior-x:contain;scroll-snap-type:x mandatory;scrollbar-width:none}
  .work-track::-webkit-scrollbar{display:none}
  .work-track::before,.work-track::after{content:""}
  .work-track:focus-visible{outline:2px solid var(--accent);outline-offset:6px}
  .work-card{min-width:0;display:grid;scroll-snap-align:center;scroll-snap-stop:always;container-type:scroll-state}
  .work-card[hidden]{display:none}
  .work-card-link{display:flex;flex-direction:column;height:100%;border:1px solid var(--line);background:var(--surface);transition:scale 320ms ease,opacity 320ms ease,border-color 180ms,box-shadow 320ms ease}
  .work-card:hover .work-card-link{border-color:var(--accent-edge)}

  /* The card at the centre is the one being read. The rest step back. */
  @container scroll-state(snapped: inline){
    .work-card-link{border-color:var(--line-strong);box-shadow:0 18px 44px rgb(0 0 0 / .45)}
  }
  @container not scroll-state(snapped: inline){
    .work-card-link{scale:.78;opacity:.38}
    .work-content>p,.work-stack,.work-card-foot{opacity:0;translate:0 12px}
  }
  /* Browsers without scroll-state queries get a plain, evenly spaced track. */
  @supports not (container-type: scroll-state){
    .work-track{gap:24px}
  }

  .work-image{padding:16px 16px 0;background:var(--ink-deep);overflow:hidden;align-self:stretch}.work-image-bar{height:27px;border:1px solid var(--line);border-bottom:0;display:flex;align-items:center;justify-content:space-between;padding:0 10px;color:var(--text-faint);font:8px var(--font-mono);background:var(--surface)}.work-image-bar>span:first-child{display:flex;gap:4px}.work-image-bar i{display:block;width:4px;height:4px;background:var(--line-control);border-radius:50%}
  .work-image :global(img){aspect-ratio:16/10;width:100%;object-fit:cover;object-position:top;transition:transform 350ms}.work-image :global(picture){display:block;overflow:hidden;border:1px solid var(--line);border-bottom:0}.work-card-link:hover :global(img){transform:scale(1.018)}
  .work-content{padding:24px 26px;flex:1;display:flex;flex-direction:column}.work-meta{display:flex;align-items:center;justify-content:space-between;gap:14px;color:var(--accent);font:9px var(--font-mono);text-transform:uppercase;letter-spacing:.1em}.work-meta>span:last-child{color:var(--text-faint)}
  .work-content h3{display:flex;justify-content:space-between;align-items:center;gap:12px;font:650 clamp(1.45rem,2.3vw,2rem)/1.15 var(--font-display);letter-spacing:-.04em;margin-top:14px}:global(.work-arrow){width:21px;height:21px;flex-shrink:0;color:var(--text-faint);transition:color 180ms,transform 180ms}.work-card-link:hover :global(.work-arrow){color:var(--accent);transform:translate(2px,-2px)}
  .work-content>p,.work-stack,.work-card-foot{transition:opacity 300ms ease,translate 300ms ease}
  .work-content>p{font-size:14px;line-height:1.7;color:var(--text-dim);margin-top:14px;max-width:55ch}.work-stack{display:flex;gap:7px;flex-wrap:wrap;margin:22px 0;list-style:none;padding:0}.work-stack li{font:9px var(--font-mono);color:var(--text-dim);padding:6px 8px;border:1px solid var(--line-strong)}
  .work-card-foot{display:flex;justify-content:space-between;align-items:center;gap:12px;border-top:1px solid var(--line);padding-top:16px;margin-top:auto;font-size:10px}.work-status{display:flex;align-items:center;gap:7px;color:var(--text-dim)}.work-status>span{height:4px;width:4px;border-radius:50%;background:var(--accent)}.work-read{color:var(--accent);display:flex;gap:12px}

  /* Round controls sit on the edge of the track, clear of the centre card. */
  .work-nav button{position:absolute;top:50%;translate:0 -50%;z-index:2;width:46px;height:46px;display:grid;place-items:center;border:1px solid var(--line-strong);border-radius:50%;background:var(--ink-deep);color:var(--text);opacity:.8;cursor:pointer;transition:opacity 160ms,scale 160ms,color 160ms,border-color 160ms}
  .work-nav button:first-child{left:-10px}.work-nav button:last-child{right:-10px}
  .work-nav button:hover:not(:disabled),.work-nav button:focus-visible{opacity:1;scale:1.08;color:var(--accent);border-color:var(--accent-edge)}
  .work-nav button:disabled{opacity:.2;cursor:default}
  .work-nav svg{width:18px;height:18px}
  .work-controls{display:flex;flex-direction:column;align-items:center;gap:10px;margin-top:10px}
  .work-dots{display:flex;gap:9px}
  .work-dots button{width:22px;height:22px;display:grid;place-items:center;padding:0;background:none;border:0;cursor:pointer}
  .work-dots button::before{content:"";width:9px;height:9px;border-radius:50%;background:var(--line-control);opacity:.45;scale:.8;transition:opacity 150ms,scale 150ms,background 150ms}
  .work-dots button:hover::before{opacity:.8}
  .work-dots button[aria-current="true"]::before{background:var(--accent);opacity:1;scale:1}
  .work-dots button[hidden]{display:none}
  .work-position{font:10px var(--font-mono);text-transform:uppercase;letter-spacing:.1em;color:var(--text-faint)}
  /* Without the script there is nothing to drive these, so they stay out. */
  .work-carousel:not([data-carousel-ready]) .work-controls,.work-carousel:not([data-carousel-ready]) .work-nav{display:none}

  @media(max-width:900px){.work-track{grid-auto-columns:min(84%,520px)}.work-content{padding:22px}}
  @media(max-width:760px){.work-filters button{padding:9px 10px;font-size:11px}.work-nav button{width:42px;height:42px}.work-nav button:first-child{left:-6px}.work-nav button:last-child{right:-6px}}
  @media(max-width:540px){.work-track{grid-auto-columns:min(92%,420px)}.work-toolbar{flex-wrap:wrap;margin-top:25px}.work-count{width:100%;padding-top:7px}.work-content h3{font-size:1.6rem}.work-content>p{font-size:13px}.work-dots{display:none}}
  @media(prefers-reduced-motion:reduce){
    .work-track{scroll-behavior:auto}
    .work-card-link,.work-content>p,.work-stack,.work-card-foot{transition:none}
    .work-card-link:hover :global(img),.work-card-link:hover :global(.work-arrow){transform:none}
    /* Movement is the effect here, so without it nothing is dimmed or hidden. */
    @container not scroll-state(snapped: inline){
      .work-card-link{scale:1;opacity:1}
      .work-content>p,.work-stack,.work-card-foot{opacity:1;translate:none}
    }
  }
</style>

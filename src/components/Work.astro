---
import { Picture } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import Icon from "./Icon.astro";
interface Props { entries: CollectionEntry<"work">[] }
const { entries } = Astro.props;
const filters = [{ id: "all", label: "All projects" }, { id: "live", label: "Live builds" }, { id: "source", label: "Source available" }];
---
<section id="work" class="section work-section" aria-labelledby="work-heading">
  <div class="shell">
    <div class="section-heading-row">
      <div><p class="section-label">01 / Selected work</p><h2 id="work-heading" class="display">Built to solve.<br /><span class="heading-muted">Made to work.</span></h2></div>
      <p class="section-intro">Real products. Real constraints. A closer look at the software I build, the decisions behind it, and the work I own.</p>
    </div>
    <div class="work-toolbar">
      <div class="work-filters" role="group" aria-label="Filter projects" hidden>
        {filters.map((filter) => <button type="button" data-work-filter={filter.id} aria-pressed={filter.id === "all"}>{filter.label}</button>)}
      </div>
      <p class="work-count" role="status" aria-live="polite"><span data-project-count>{String(entries.length).padStart(2, "0")}</span> projects</p>
    </div>
    <div class="work-grid">
      {entries.map((entry, index) => (
        <article class:list={["work-card", { "work-card-featured": index === 0 }]} data-work-card data-live={entry.data.status === "Deployed"} data-source={entry.data.repositoryUrl !== null}>
          <a href={`/work/${entry.id}`} class="work-card-link">
            <div class="work-image">
              <div class="work-image-bar" aria-hidden="true"><span><i></i><i></i><i></i></span><span>{entry.data.shortTitle}</span><span>↗</span></div>
              <Picture src={entry.data.screenshot} alt={entry.data.screenshotAlt} widths={[480, 800, 1200]} sizes="(min-width: 1000px) 650px, (min-width: 640px) 50vw, 100vw" formats={["avif", "webp"]} fallbackFormat="webp" loading="lazy" class="work-screenshot" />
            </div>
            <div class="work-content">
              <div class="work-meta"><span>{index === 0 ? "Featured project" : entry.data.sector}</span><span>{String(index + 1).padStart(2, "0")}</span></div>
              <h3>{entry.data.shortTitle}<Icon name="arrow-up-right" class="work-arrow h-5 w-5 shrink-0" /></h3>
              <p>{entry.data.summary}</p>
              <ul class="work-stack" aria-label="Technologies">{entry.data.technologies.slice(0, 3).map((tech) => <li>{tech}</li>)}</ul>
              <div class="work-card-foot"><span class="work-status"><span></span>{entry.data.status}</span><span class="work-read">View case study <span aria-hidden="true">↗</span></span></div>
            </div>
          </a>
        </article>
      ))}
    </div>
  </div>
</section>
<script>
  const filters = document.querySelector<HTMLElement>(".work-filters");
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-work-filter]"));
  const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-work-card]"));
  const count = document.querySelector("[data-project-count]");
  if (filters && cards.length) {
    filters.hidden = false;
    buttons.forEach((button) => button.addEventListener("click", () => {
      const filter = button.dataset.workFilter;
      buttons.forEach((item) => item.setAttribute("aria-pressed", String(item === button)));
      cards.forEach((card) => { card.hidden = filter === "live" ? card.dataset.live !== "true" : filter === "source" ? card.dataset.source !== "true" : false; });
      if (count) count.textContent = String(cards.filter((card) => !card.hidden).length).padStart(2, "0");
    }));
  }
</script>
<style>
  .work-section{background:var(--ink);position:relative}
  .work-toolbar{display:flex;justify-content:space-between;align-items:center;gap:12px;margin:38px 0 25px;padding-bottom:18px;border-bottom:1px solid var(--line)}
  .work-filters:not([hidden]){display:flex;gap:6px;flex-wrap:wrap}.work-filters button{padding:10px 16px;min-height:44px;font-size:12px;color:var(--text-dim);border:1px solid transparent;transition:background 160ms,color 160ms;cursor:pointer}.work-filters button[aria-pressed="true"]{background:var(--accent-wash);border-color:var(--accent-edge);color:var(--accent)}.work-filters button:hover{color:var(--text);border-color:var(--line-control)}
  .work-count{white-space:nowrap;font:10px var(--font-mono);text-transform:uppercase;letter-spacing:.1em;color:var(--text-faint)}.work-count span{color:var(--text)}
  .work-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:28px}
  .work-card{min-width:0;border:1px solid var(--line);background:var(--surface);transition:border-color 180ms}.work-card:hover{border-color:var(--accent-edge)}.work-card[hidden]{display:none}
  .work-card-link{display:flex;flex-direction:column;height:100%}.work-image{padding:16px 16px 0;background:var(--ink-deep);overflow:hidden;align-self:stretch}.work-image-bar{height:27px;border:1px solid var(--line);border-bottom:0;display:flex;align-items:center;justify-content:space-between;padding:0 10px;color:var(--text-faint);font:8px var(--font-mono);background:var(--surface)}.work-image-bar>span:first-child{display:flex;gap:4px}.work-image-bar i{display:block;width:4px;height:4px;background:var(--line-control);border-radius:50%}
  .work-image :global(img){aspect-ratio:16/10;width:100%;object-fit:cover;object-position:top;transition:transform 350ms}.work-image :global(picture){display:block;overflow:hidden;border:1px solid var(--line);border-bottom:0}.work-card-link:hover :global(img){transform:scale(1.018)}
  .work-content{padding:25px 27px;flex:1;display:flex;flex-direction:column}.work-meta{display:flex;align-items:center;justify-content:space-between;gap:14px;color:var(--accent);font:9px var(--font-mono);text-transform:uppercase;letter-spacing:.1em}.work-meta>span:last-child{color:var(--text-faint)}
  .work-content h3{display:flex;justify-content:space-between;align-items:center;gap:12px;font:650 clamp(1.45rem,2.3vw,2rem)/1.15 var(--font-display);letter-spacing:-.04em;margin-top:14px}:global(.work-arrow){width:21px;height:21px;flex-shrink:0;color:var(--text-faint);transition:color 180ms,transform 180ms}.work-card-link:hover :global(.work-arrow){color:var(--accent);transform:translate(2px,-2px)}
  .work-content>p{font-size:14px;line-height:1.7;color:var(--text-dim);margin-top:14px;max-width:55ch}.work-stack{display:flex;gap:7px;flex-wrap:wrap;margin:22px 0}.work-stack li{font:9px var(--font-mono);color:var(--text-dim);padding:6px 8px;border:1px solid var(--line-strong)}
  .work-card-foot{display:flex;justify-content:space-between;align-items:center;gap:12px;border-top:1px solid var(--line);padding-top:16px;margin-top:auto;font-size:10px}.work-status{display:flex;align-items:center;gap:7px;color:var(--text-dim)}.work-status>span{height:4px;width:4px;border-radius:50%;background:var(--accent)}.work-read{color:var(--accent);display:flex;gap:12px}
  .work-card-featured{grid-column:1/-1}.work-card-featured .work-card-link{display:grid;grid-template-columns:1.3fr 1fr}.work-card-featured .work-image{display:flex;flex-direction:column;justify-content:center;padding:32px;background:var(--ink-deep)}.work-card-featured .work-image :global(img){aspect-ratio:16/11}.work-card-featured .work-content{padding:40px}.work-card-featured h3{font-size:clamp(2rem,3.8vw,3.1rem);margin-top:24px}.work-card-featured .work-stack{margin-block:26px}
  @media(max-width:760px){.work-grid{gap:20px}.work-card-featured .work-card-link{display:flex}.work-card-featured .work-image{padding:16px 16px 0}.work-card-featured .work-image :global(img){aspect-ratio:16/10}.work-card-featured .work-content,.work-content{padding:22px}.work-card-featured h3{font-size:1.75rem;margin-top:14px}.work-filters button{padding:9px 10px;font-size:11px}}
  @media(max-width:540px){.work-grid{grid-template-columns:1fr}.work-toolbar{flex-wrap:wrap;margin-top:25px}.work-count{width:100%;padding-top:7px}.work-content h3{font-size:1.6rem}.work-content>p{font-size:13px}}
  @media(prefers-reduced-motion:reduce){.work-card-link:hover :global(img),.work-card-link:hover :global(.work-arrow){transform:none}}
</style>

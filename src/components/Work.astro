---
import { Picture } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import Icon from "./Icon.astro";
interface Props { entries: CollectionEntry<"work">[] }
const { entries } = Astro.props;
const filters = [{ id: "all", label: "All projects" }, { id: "live", label: "Live builds" }, { id: "source", label: "Source available" }];
---
<section id="work" class="section rule-top work-section" aria-labelledby="work-heading">
  <div class="shell">
    <div class="section-heading-row">
      <div><p class="section-label">02 / Web applications</p><h2 id="work-heading" class="display">Built to solve.<br /><span class="heading-muted">Made to work.</span></h2></div>
      <p class="section-intro">Operational web products running in production. A closer look at the software I build, the decisions behind it, and the work I own.</p>
    </div>
    <div class="work-toolbar">
      <div class="work-filters" role="group" aria-label="Filter projects" hidden>
        {filters.map((filter) => <button type="button" data-work-filter={filter.id} aria-pressed={filter.id === "all"}>{filter.label}</button>)}
      </div>
      <p class="work-count" role="status" aria-live="polite"><span data-project-count>{String(entries.length).padStart(2, "0")}</span> projects</p>
    </div>
    <div class="work-carousel" data-work-carousel>
      <div class="work-stage">
        <ul
          id="work-track"
          class="work-track"
          data-carousel-track
          tabindex="0"
          aria-roledescription="carousel"
          aria-label="Web application projects. Scroll sideways to browse."
        >
          {entries.map((entry, index) => (
            <li class="work-card" data-carousel-slide data-carousel-title={entry.data.shortTitle} data-work-card data-live={entry.data.status === "Deployed"} data-source={entry.data.repositoryUrl !== null}>
              <a href={`/work/${entry.id}`} class="work-card-link">
                <div class="work-image">
                  <div class="work-image-bar" aria-hidden="true"><span><i></i><i></i><i></i></span><span>{entry.data.shortTitle} / web</span><span>↗</span></div>
                  <Picture src={entry.data.screenshot} alt={entry.data.screenshotAlt} widths={[480, 800, 1200, 1400]} sizes="(min-width: 1180px) 720px, (min-width: 900px) 56vw, 92vw" formats={["avif", "webp"]} fallbackFormat="webp" loading="lazy" class="work-screenshot" />
                </div>
                <div class="work-content">
                  <div class="work-meta"><span>{entry.data.sector}</span><span>{String(index + 1).padStart(2, "0")}</span></div>
                  <h3>{entry.data.shortTitle}<Icon name="arrow-up-right" class="work-arrow h-5 w-5 shrink-0" /></h3>
                  <p>{entry.data.summary}</p>
                  <ul class="work-stack" aria-label="Technologies">{entry.data.technologies.slice(0, 3).map((tech) => <li>{tech}</li>)}</ul>
                  <div class="work-card-foot"><span class="work-status"><span></span>{entry.data.status}</span><span class="work-read">View case study <span aria-hidden="true">↗</span></span></div>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </div>
      <div class="work-controls">
        <div class="work-pagination"><p class="work-position" role="status" aria-live="polite" data-carousel-status>1 of {entries.length}</p><div class="work-progress" data-carousel-progress aria-hidden="true"><span></span></div></div>
        <div class="work-nav">
          <button type="button" data-carousel-prev aria-label="Previous project" aria-controls="work-track">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M15 5l-7 7 7 7" stroke-linecap="square" /></svg>
          </button>
          <button type="button" data-carousel-next aria-label="Next project" aria-controls="work-track">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M9 5l7 7-7 7" stroke-linecap="square" /></svg>
          </button>
        </div>
      </div>
        <div class="work-dots" role="group" aria-label="Jump to a project">
          {entries.map((entry, index) => (
            <button type="button" data-carousel-marker={index} aria-current={index === 0} aria-label={`Show ${entry.data.shortTitle}`}></button>
          ))}
        </div>
    </div>
  </div>
</section>
<script>
  import { initCarousel } from "../scripts/carousel";

  const root = document.querySelector<HTMLElement>("[data-work-carousel]");
  const carousel = root ? initCarousel(root) : null;

  const filters = document.querySelector<HTMLElement>(".work-filters");
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-work-filter]"));
  const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-work-card]"));
  const count = document.querySelector("[data-project-count]");

  if (filters && carousel && cards.length) {
    filters.hidden = false;
    buttons.forEach((button) => button.addEventListener("click", () => {
      const filter = button.dataset.workFilter;
      buttons.forEach((item) => item.setAttribute("aria-pressed", String(item === button)));
      cards.forEach((card) => {
        card.hidden = filter === "live" ? card.dataset.live !== "true"
          : filter === "source" ? card.dataset.source !== "true"
          : false;
      });
      if (count) count.textContent = String(cards.filter((card) => !card.hidden).length).padStart(2, "0");
      carousel.refresh();
    }));
  }
</script>
<style>
.work-section { position: relative; }
  .work-toolbar { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin: 36px 0 22px; }
  .work-filters:not([hidden]) { display: flex; gap: 4px; flex-wrap: wrap; }
  .work-filters button { min-height: 44px; padding: 10px 16px; border: 1px solid transparent; border-radius: 4px; color: var(--text-dim); font-size: 12px; cursor: pointer; transition: background 180ms, color 180ms, border-color 180ms; }
  .work-filters button[aria-pressed="true"] { color: var(--accent); background: var(--accent-wash); border-color: var(--accent-edge); }
  .work-count { color: var(--text-faint); font: 10px var(--font-mono); white-space: nowrap; }
  .work-count span { color: var(--text); }

  /* Small edge previews keep the next browser project in view. */
  .work-track { --slide-width: 92%; --slide-gap: 22px; display: flex; gap: var(--slide-gap); list-style: none; margin: 0; padding: 12px 0 28px; overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x mandatory; scrollbar-width: none; }
  .work-track::-webkit-scrollbar { display: none; }
  .work-track::before, .work-track::after { content: ""; flex: 0 0 calc((100% - var(--slide-width)) / 2); }
  .work-track::before { margin-right: calc(-1 * var(--slide-gap)); }
  .work-track::after { margin-left: calc(-1 * var(--slide-gap)); }
  .work-track:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .work-card { min-width: 0; flex: 0 0 var(--slide-width); display: grid; scroll-snap-align: center; }
  .work-card[hidden] { display: none; }
  .work-card-link { display: grid; grid-template-columns: 1.45fr 1fr; min-height: 410px; overflow: hidden; border: 1px solid var(--line-strong); border-radius: 8px; background: var(--surface); transform: scale(calc(1 - var(--slide-distance, 0) * .035)); transition: border-color 220ms, box-shadow 300ms; }
  .work-card[data-active="true"] .work-card-link { border-color: var(--accent-edge); box-shadow: 0 18px 35px -24px var(--hero-shadow); }
  .work-image { min-width: 0; display: flex; flex-direction: column; justify-content: center; padding: clamp(18px, 3vw, 42px); background: var(--ink-deep); border-right: 1px solid var(--line); }
  .work-image-bar { height: 34px; display: flex; align-items: center; justify-content: space-between; padding: 0 12px; background: var(--surface-raised); border: 1px solid var(--line-strong); border-bottom: 0; border-radius: 6px 6px 0 0; font: 9px var(--font-mono); color: var(--text-dim); }
  .work-image-bar > span:first-child { display: flex; gap: 5px; }
  .work-image-bar i { width: 5px; height: 5px; background: var(--line-control); border-radius: 50%; }
  .work-image :global(picture) { display: block; overflow: hidden; border: 1px solid var(--line-strong); border-radius: 0 0 4px 4px; box-shadow: 0 14px 28px -18px var(--hero-shadow); }
  .work-image :global(img) { width: 100%; aspect-ratio: 16/10; object-fit: cover; object-position: top; transition: transform 650ms cubic-bezier(.22,1,.36,1); }
  .work-content { min-width: 0; padding: clamp(22px, 3vw, 42px); display: flex; flex-direction: column; justify-content: center; }
  .work-meta { display: flex; justify-content: space-between; gap: 12px; color: var(--accent); font: 10px/1.6 var(--font-mono); letter-spacing: .07em; text-transform: uppercase; }
  .work-meta > span:last-child { color: var(--text-faint); }
  .work-content h3 { display: flex; align-items: center; justify-content: space-between; gap: 14px; font: 650 clamp(1.65rem, 2.8vw, 2.7rem)/1.08 var(--font-display); letter-spacing: -.045em; margin-top: 24px; }
  :global(.work-arrow) { width: 22px; height: 22px; color: var(--accent); flex-shrink: 0; transition: transform 220ms; }
  .work-content > p { margin-top: 18px; font-size: 14px; line-height: 1.8; color: var(--text-dim); max-width: 45ch; }
  .work-stack { display: flex; flex-wrap: wrap; gap: 8px 14px; list-style: none; padding: 0; margin: 24px 0 30px; }
  .work-stack li { font: 10px/1.5 var(--font-mono); color: var(--text-faint); }
  .work-card-foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 14px; margin-top: auto; padding-top: 20px; border-top: 1px solid var(--line); font-size: 11px; }
  .work-status { display: flex; align-items: center; gap: 7px; color: var(--text-dim); }
  .work-status > span { width: 4px; height: 4px; border-radius: 50%; background: var(--accent); }
  .work-read { display: flex; gap: 15px; color: var(--accent); }
  .work-controls { display: flex; align-items: center; justify-content: space-between; gap: 30px; padding-inline: 4%; }
  .work-pagination { display: flex; align-items: center; flex: 1; max-width: 520px; gap: 22px; }
  .work-position { white-space: nowrap; font: 11px var(--font-mono); color: var(--text-dim); }
  .work-progress { height: 2px; flex: 1; overflow: hidden; background: var(--line-strong); }
  .work-progress span { display: block; height: 100%; background: var(--accent); transform: scaleX(var(--carousel-progress, .125)); transform-origin: left; transition: transform 350ms cubic-bezier(.22,1,.36,1); }
  .work-nav { display: flex; gap: 8px; }
  .work-nav button { display: grid; place-items: center; width: 48px; height: 48px; border: 1px solid var(--line-control); border-radius: 4px; background: var(--surface); color: var(--text); cursor: pointer; transition: background 180ms, color 180ms, border-color 180ms, transform 180ms; }
  .work-nav button:disabled { opacity: .35; cursor: default; }
  .work-nav svg { width: 18px; height: 18px; }
  .work-dots { display: flex; flex-wrap: wrap; justify-content: center; gap: 0; margin: 4px auto 0; }
  .work-dots button { display: grid; place-items: center; width: 44px; height: 44px; padding: 0; cursor: pointer; }
  .work-dots button::before { content: ""; width: 20px; height: 2px; background: var(--line-control); transition: background 200ms, transform 250ms; }
  .work-dots button[aria-current="true"]::before { background: var(--accent); transform: scaleX(1.4); }
  .work-dots button[hidden] { display: none; }
  .work-carousel:not([data-carousel-ready]) .work-controls, .work-carousel:not([data-carousel-ready]) .work-dots { display: none; }
  @media (hover: hover) and (pointer: fine) {
    .work-card-link:hover { border-color: var(--accent); }
    .work-card-link:hover :global(img) { transform: scale(1.025); }
    .work-card-link:hover :global(.work-arrow) { transform: translate(3px,-3px); }
    .work-nav button:hover:not(:disabled) { background: var(--accent-wash); color: var(--accent); border-color: var(--accent); transform: translateY(-2px); }
    .work-filters button:hover { color: var(--text); background: var(--surface-raised); }
  }
  @media (max-width: 1000px) { .work-card-link { grid-template-columns: 1.15fr 1fr; } .work-image { padding: 20px; } .work-content { padding: 26px; } }
  @media (max-width: 800px) { .work-card-link { grid-template-columns: 1fr; } .work-image { padding: 22px; border-right: 0; border-bottom: 1px solid var(--line); } .work-image :global(img) { aspect-ratio: 16/9; } .work-content h3 { margin-top: 14px; } .work-content > p { max-width: none; } }
  @media (max-width: 540px) { .work-track { --slide-width: 95%; --slide-gap: 12px; padding-bottom: 18px; } .work-toolbar { align-items: flex-start; flex-direction: column; gap: 10px; margin-top: 28px; } .work-filters button { padding-inline: 10px; font-size: 11px; } .work-image { padding: 14px; } .work-image-bar { font-size: 8px; } .work-content { padding: 22px; } .work-content > p { font-size: 13px; } .work-controls { padding-inline: 2.5%; gap: 20px; } .work-pagination { gap: 14px; } .work-dots button { width: 32px; } }
  @media (prefers-reduced-motion: reduce) { .work-card-link, .work-image :global(img), :global(.work-arrow), .work-progress span, .work-nav button, .work-dots button::before { transition: none; transform: none !important; } .work-progress span { transform: scaleX(var(--carousel-progress, .125)) !important; } }
</style>

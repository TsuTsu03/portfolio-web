---
import { Picture } from "astro:assets";
import portrait from "../assets/portrait/den-jansen-flores.png";
import manga from "../assets/portrait/den-manga-vigilante.png";
import { person } from "../data/site";
---

<section id="about" class="section rule-top relative overflow-hidden" aria-labelledby="about-heading">
  <div class="shell profile-grid">
    <div class="reveal profile-image">
      <button
        type="button"
        class="identity frame group/id w-full"
        aria-label="Switch between the color portrait and black-and-white manga panel"
        aria-pressed="false"
        data-identity
      >
        <span class="identity-state identity-state-base">
          <Picture
            src={portrait}
            alt={`${person.name} in a black polo shirt, cap and sunglasses, seated inside a dark architectural frame.`}
            widths={[420, 640, 900, 1086]}
            sizes="(min-width: 1024px) 46vw, 100vw"
            formats={["avif", "webp"]}
            fallbackFormat="webp"
            quality={95}
            loading="lazy"
          />
        </span>

        <span class="identity-state identity-state-manga" aria-hidden="true">
          <Picture
            src={manga}
            alt=""
            widths={[420, 640, 900, 1086]}
            sizes="(min-width: 1024px) 46vw, 100vw"
            formats={["avif", "webp"]}
            fallbackFormat="webp"
            quality={92}
            loading="lazy"
          />
        </span>

        <span class="identity-ink" aria-hidden="true"></span>
        <span class="identity-scan" aria-hidden="true"></span>

        <span class="identity-hint" aria-hidden="true">Switch view</span>
      </button>

      <div class="profile-caption">
        <p class="meta">{person.locality}, Philippines</p>
        <p class="meta">Portrait / Alter ego</p>
      </div>
    </div>

    <div class="reveal profile-copy">
      <p class="meta profile-label">01 / About</p>
      <h2 id="about-heading" class="display profile-heading">
        The person<br />behind the build.
      </h2>

      <p class="profile-name">{person.name}</p>
      <div class="prose-body profile-body text-text-dim">
        <p>
          Senior full-stack developer and agentic AI engineer in Metro Manila. I build
          web platforms and AI workflows for teams in the Philippines and abroad, from
          <a class="link" href="/work/clinicflow">healthcare operations</a> to
          <a class="link" href="/work/biyahero-express">courier logistics</a> and
          <a class="link" href="/work/data-analysis-platform">AI-assisted analysis</a>.
        </p>
        <p>
          I follow the work before choosing the tools: who handles each record, what happens
          next, and where things get stuck. Then I own the build from the database to the screen.
        </p>
        <p>
          We agree on scope before work starts. Updates come directly from me. If a feature
          adds cost without helping the business, I say so.
        </p>
      </div>

      <dl class="profile-facts">
        <div><dt class="meta">Focus</dt><dd>Full-stack systems &amp; agentic AI</dd></div>
        <div><dt class="meta">Based in</dt><dd>{person.locality} · {person.timezone}</dd></div>
      </dl>
    </div>
  </div>
</section>

<style>
  .profile-grid { display: grid; gap: 2.5rem; align-items: center; }
  .profile-image { min-width: 0; }
  .profile-image .identity { border: 1px solid var(--line-strong); }
  .profile-caption { display: flex; justify-content: space-between; gap: 1rem; margin-top: 1rem; }
  .profile-label { margin-bottom: 1.75rem; color: var(--accent); }
  .profile-heading { font-size: clamp(2.75rem, 5vw, 4.7rem); line-height: 1; }
  .profile-name { margin-top: 2rem; font-weight: 600; font-size: 1.1rem; }
  .profile-body { margin-top: 1rem; font-size: 1rem; }
  .profile-facts { margin-top: 2rem; border-top: 1px solid var(--line); }
  .profile-facts > div { display: flex; justify-content: space-between; gap: 1.5rem; padding-block: 1rem; border-bottom: 1px solid var(--line); }
  .profile-facts dd { font-size: .85rem; text-align: right; }
  @media (min-width: 900px) {
    .profile-grid { grid-template-columns: minmax(0, .9fr) minmax(0, 1fr); gap: clamp(3rem, 7vw, 7rem); }
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-identity]").forEach((identity) => {
    identity.addEventListener("click", () => {
      const next = identity.getAttribute("aria-pressed") !== "true";
      identity.setAttribute("aria-pressed", String(next));
    });

    if (!window.matchMedia("(hover: hover) and (pointer: fine)").matches) return;

    identity.addEventListener(
      "pointermove",
      (event) => {
        const rect = identity.getBoundingClientRect();
        identity.style.setProperty("--ix", `${((event.clientX - rect.left) / rect.width) * 100}%`);
        identity.style.setProperty("--iy", `${((event.clientY - rect.top) / rect.height) * 100}%`);
      },
      { passive: true }
    );
  });
</script>

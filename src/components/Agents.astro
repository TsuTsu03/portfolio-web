---
import { agents } from "../data/agents";
---

<section id="agents" class="section rule-top" aria-labelledby="agents-heading">
  <div class="shell">
    <span aria-hidden="true" class="section-tick reveal"></span>
    <p class="meta mb-5 text-accent">Built to do a job</p>
    <div class="grid gap-6 lg:grid-cols-[1fr_1fr] lg:items-end">
      <h2 id="agents-heading" class="display max-w-[16ch] text-[clamp(2rem,5vw,3.75rem)]">AI Agents</h2>
      <p class="max-w-[62ch] text-lg leading-relaxed text-text-dim">Three different jobs, three demos you can use right here. The public scenarios use fictional data. Each page explains what the full project does and where the demo stops.</p>
    </div>
    <div class="mt-11 grid gap-px border border-line-strong bg-line-strong lg:grid-cols-3">
      {agents.map((agent, index) => (
        <article class="group bg-ink p-6 sm:p-8">
          <p class="meta text-accent">0{index + 1} / {agent.role}</p>
          <div class="mt-6 aspect-[16/10] overflow-hidden border border-line bg-surface">
            <img src={agent.image} alt={agent.imageAlt} loading="lazy" class:list={["h-full w-full object-top", agent.slug === "alfred" ? "object-contain" : "object-cover"]} />
          </div>
          <h3 class="display-tight mt-6 text-2xl">{agent.name}</h3>
          <p class="mt-3 min-h-24 text-text-dim">{agent.summary}</p>
          <a href={`/agents/${agent.slug}`} class="mt-5 inline-flex min-h-11 items-center gap-2 border-b border-accent text-sm font-medium text-accent transition-colors hover:text-text">Try {agent.name} <span aria-hidden="true">↗</span></a>
        </article>
      ))}
    </div>
  </div>
</section>

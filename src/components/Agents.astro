---
import { agents } from "../data/agents";
---
<section id="agents" class="section rule-top agent-section" aria-labelledby="agents-heading">
  <div class="shell">
    <div class="section-heading-row">
      <div><p class="section-label">04 / Applied intelligence</p><h2 id="agents-heading" class="display">Meet the<br /><span class="heading-muted">other team.</span></h2></div>
      <p class="section-intro">AI agents with a job to do. Explore the interfaces, try the workflows, and see where human approval stays in control.</p>
    </div>
    <div class="agent-carousel" data-agent-carousel>
      <div class="agent-tabs" role="group" aria-label="Jump to an agent">
        {agents.map((agent, index) => (
          <button type="button" data-coverflow-marker={index} aria-current={index === 0} aria-controls="agent-stage"><span class="agent-tab-number">0{index + 1}</span><span>{agent.name}<small>{agent.role}</small></span><span class="agent-tab-arrow" aria-hidden="true">↗</span></button>
        ))}
      </div>
      <div id="agent-stage" class="agent-stage" role="group" aria-roledescription="carousel" aria-label="AI agent projects">
        {agents.map((agent, index) => (
          <article class="agent-panel" data-coverflow-slide data-slot={index === 0 ? "0" : index} aria-labelledby={`agent-name-${agent.slug}`}>
            <a href={`/agents/${agent.slug}#demo`} class="agent-preview" aria-label={`Try ${agent.name}'s interactive demo`}>
              <img src={agent.screenshot} alt={agent.screenshotAlt} loading="lazy" width="1440" height="900" />
              <span class="agent-preview-link">Explore the interface <span aria-hidden="true">↗</span></span>
            </a>
            <div class="agent-info">
              <p class="section-label">Agent 0{index + 1} / {agent.role}</p>
              <h3 id={`agent-name-${agent.slug}`}>{agent.name}<span>.</span></h3>
              <p>{agent.summary}</p>
              <ul>{agent.capabilities.map((capability) => <li><span aria-hidden="true">↳</span>{capability}</li>)}</ul>
              <a href={`/agents/${agent.slug}#demo`} class="btn btn-primary">Try {agent.name}'s demo <span aria-hidden="true">↗</span></a>
              <p class="agent-note">Interactive demo · Fictional data</p>
            </div>
          </article>
        ))}
      </div>
      <div class="agent-controls">
        <button type="button" class="agent-toggle" data-coverflow-toggle aria-pressed="false" aria-label="Pause the agent carousel">Pause</button>
        <p class="agent-position" role="status" aria-live="polite" data-coverflow-status>1 of {agents.length}</p>
        <div class="agent-nav">
          <button type="button" data-coverflow-prev aria-label="Previous agent" aria-controls="agent-stage">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M15 5l-7 7 7 7" stroke-linecap="square" /></svg>
          </button>
          <button type="button" data-coverflow-next aria-label="Next agent" aria-controls="agent-stage">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M9 5l7 7-7 7" stroke-linecap="square" /></svg>
          </button>
        </div>
      </div>
    </div>
    <div class="agent-section-foot"><p>Built for useful work. Designed for human oversight.</p><a href="/agents">All agent projects <span aria-hidden="true">↗</span></a></div>
  </div>
</section>
<script>
  import { initCoverflow } from "../scripts/coverflow";

  const root = document.querySelector<HTMLElement>("[data-agent-carousel]");
  if (root) initCoverflow(root);
</script>
<style>
  .agent-tabs{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));margin-top:42px;border:1px solid var(--line)}
  .agent-tabs button{min-width:0;text-align:left;display:flex;align-items:center;gap:14px;padding:20px 23px;border-right:1px solid var(--line);border-bottom:2px solid transparent;background:var(--ink);color:var(--text-dim);cursor:pointer;transition:background 160ms}.agent-tabs button:last-child{border-right:0}.agent-tabs button[aria-current="true"]{border-bottom-color:var(--accent);background:var(--accent-wash);color:var(--text)}.agent-tabs button:hover{background:var(--surface-raised)}.agent-tabs button>span:nth-child(2){font-size:18px;font-weight:550}.agent-tabs small{display:block;font-size:10px;font-weight:400;color:var(--text-dim);margin-top:5px}.agent-tab-number{font:10px var(--font-mono);color:var(--accent)}.agent-tab-arrow{margin-left:auto;color:var(--accent)}

  /*
    One deck, one card in front. Every card shares the same grid cell, so the
    stage is as tall as the tallest card and nothing is positioned by hand.
  */
  .agent-stage{display:grid;overflow:hidden;padding:34px 0 26px;isolation:isolate}
  .agent-panel{grid-area:1/1;justify-self:center;width:min(100%,720px);border:1px solid var(--line);background:var(--surface);transition:translate 650ms cubic-bezier(.37,0,.63,1),scale 650ms cubic-bezier(.37,0,.63,1),opacity 650ms ease,visibility 650ms}
  .agent-panel[data-slot="0"]{translate:0;scale:1;opacity:1;visibility:visible;z-index:2;box-shadow:0 24px 60px rgb(0 0 0 / .5)}
  .agent-panel[data-slot="1"]{translate:calc(100% + 26px);scale:.9;opacity:.5;visibility:visible;z-index:1}
  .agent-panel[data-slot="-1"]{translate:calc(-100% - 26px);scale:.9;opacity:.5;visibility:visible;z-index:1}
  .agent-panel:not([data-slot="0"]):not([data-slot="1"]):not([data-slot="-1"]){translate:200%;scale:.7;opacity:0;visibility:hidden;z-index:0}
  /* Before the script runs, the first card is the only one on stage. */
  .agent-carousel:not([data-coverflow-ready]) .agent-panel:not([data-slot="0"]){visibility:hidden;opacity:0}

  .agent-preview{display:block;position:relative;overflow:hidden;background:var(--ink-deep);border-bottom:1px solid var(--line)}.agent-preview img{width:100%;height:auto;aspect-ratio:16/9;object-fit:cover;object-position:top;transition:transform 300ms}.agent-preview:hover img{transform:scale(1.02)}.agent-preview-link{display:flex;align-items:center;justify-content:space-between;font-size:11px;padding:14px 18px;color:var(--text-dim);border-top:1px solid var(--line)}.agent-preview-link>span{color:var(--accent)}
  .agent-info{padding:28px 30px 32px}
  .agent-info>.section-label{font-size:9px;margin-bottom:14px}.agent-info h3{font:650 clamp(2.1rem,3.4vw,3.2rem)/1 var(--font-display);letter-spacing:-.05em}.agent-info h3>span{color:var(--accent)}.agent-info>p:not(.section-label):not(.agent-note){color:var(--text-dim);font-size:14px;line-height:1.7;margin-top:18px;max-width:60ch}.agent-info ul{margin:20px 0;display:grid;gap:10px;list-style:none;padding:0}.agent-info li{display:flex;gap:12px;font-size:12px;color:var(--text-dim)}.agent-info li>span{color:var(--accent)}.agent-info .btn{font-size:12px;gap:25px}.agent-note{font:9px var(--font-mono);color:var(--text-faint);margin-top:14px}

  .agent-controls{display:flex;align-items:center;gap:16px}
  .agent-toggle{min-height:44px;padding:0 16px;border:1px solid var(--line-strong);background:transparent;color:var(--text-dim);font:10px var(--font-mono);text-transform:uppercase;letter-spacing:.1em;cursor:pointer;transition:color 160ms,border-color 160ms,background 160ms}
  .agent-toggle:hover,.agent-toggle:focus-visible{color:var(--accent);border-color:var(--accent-edge);background:var(--accent-wash)}
  .agent-position{margin-right:auto;font:10px var(--font-mono);text-transform:uppercase;letter-spacing:.1em;color:var(--text-faint)}
  .agent-nav{display:flex;gap:8px}
  .agent-nav button{width:46px;height:46px;display:grid;place-items:center;border:1px solid var(--line-strong);border-radius:50%;background:var(--ink-deep);color:var(--text);opacity:.8;cursor:pointer;transition:opacity 160ms,scale 160ms,color 160ms,border-color 160ms}
  .agent-nav button:hover,.agent-nav button:focus-visible{opacity:1;scale:1.08;color:var(--accent);border-color:var(--accent-edge)}
  .agent-nav svg{width:18px;height:18px}
  /* Nothing drives the controls without the script, so they stay out. */
  .agent-carousel:not([data-coverflow-ready]) .agent-tabs,.agent-carousel:not([data-coverflow-ready]) .agent-controls{display:none}

  .agent-section-foot{border-top:1px solid var(--line);display:flex;justify-content:space-between;gap:20px;padding-top:20px;margin-top:26px;font-size:11px;color:var(--text-faint)}.agent-section-foot a{color:var(--accent);display:flex;gap:20px;min-height:44px;align-items:center}.agent-section-foot p{align-self:center}
  @media(max-width:900px){.agent-tabs button{padding:16px 12px;gap:10px}.agent-tabs small{font-size:9px}.agent-tab-arrow{display:none}.agent-info h3{font-size:2.4rem}.agent-info{padding:24px}}
  @media(max-width:540px){.agent-tabs button{flex-direction:column;align-items:flex-start;gap:8px;padding:14px 10px}.agent-tabs button>span:nth-child(2){font-size:14px}.agent-tabs small{font-size:9px;line-height:1.5}.agent-controls{flex-wrap:wrap}.agent-section-foot{flex-direction:column;gap:4px}.agent-section-foot p{align-self:flex-start}}
  @media(prefers-reduced-motion:reduce){.agent-panel{transition:none}.agent-preview:hover img{transform:none}}
</style>

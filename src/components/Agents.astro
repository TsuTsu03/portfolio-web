---
import { agents } from "../data/agents";
---
<section id="agents" class="section rule-top agent-section" aria-labelledby="agents-heading">
  <div class="shell">
    <div class="section-heading-row">
      <div><p class="section-label">04 / Applied intelligence</p><h2 id="agents-heading" class="display">Meet the<br /><span class="heading-muted">other team.</span></h2></div>
      <p class="section-intro">AI agents with a job to do. Explore the interfaces, try the workflows, and see where human approval stays in control.</p>
    </div>
    <div class="agent-carousel" data-agent-carousel>
      <aside class="agent-directory">
        <div class="agent-directory-heading"><span>Choose your agent</span><span>{String(agents.length).padStart(2, "0")}</span></div>
        <div class="agent-tabs" role="group" aria-label="Choose an AI agent">
          {agents.map((agent, index) => (
            <button type="button" data-coverflow-marker={index} aria-current={index === 0} aria-controls={`agent-panel-${agent.slug}`}>
              <span class="agent-tab-number">{String(index + 1).padStart(2, "0")}</span>
              <span class="agent-tab-copy">{agent.name}<small>{agent.role}</small></span>
              <span class="agent-tab-arrow" aria-hidden="true">↗</span>
            </button>
          ))}
        </div>
        <div class="agent-directory-note"><span aria-hidden="true">↳</span><p>Different roles.<br />Human oversight.</p></div>
      </aside>
      <div class="agent-workspace">
        <div class="agent-workspace-heading"><span>Inside the workspace</span><span>Interactive demos</span></div>
        <div id="agent-stage" class="agent-stage" role="region" aria-label="AI agent projects">
          {agents.map((agent, index) => (
            <article id={`agent-panel-${agent.slug}`} class="agent-panel" data-coverflow-slide data-agent-name={agent.name} data-state={index === 0 ? "active" : "idle"} aria-labelledby={`agent-name-${agent.slug}`}>
              <a href={`/agents/${agent.slug}#demo`} class="agent-preview" aria-label={`Try ${agent.name}'s interactive demo`}>
                <div class="agent-preview-image"><img src={agent.screenshot} alt={agent.screenshotAlt} loading="lazy" width="1440" height="900" /></div>
                <span class="agent-preview-link"><span>Explore {agent.name}'s interface</span><span aria-hidden="true">↗</span></span>
              </a>
              <div class="agent-info">
                <div class="agent-overview">
                  <p class="section-label">{agent.role}</p>
                  <h3 id={`agent-name-${agent.slug}`}>{agent.name}<span>.</span></h3>
                  <p class="agent-summary">{agent.summary}</p>
                </div>
                <div class="agent-details">
                  <ul>{agent.capabilities.map((capability) => <li><span aria-hidden="true">↳</span>{capability}</li>)}</ul>
                  <a href={`/agents/${agent.slug}#demo`} class="agent-demo-link">Try {agent.name}'s demo <span aria-hidden="true">↗</span></a>
                  <p class="agent-note">Interactive demo · Fictional data</p>
                </div>
              </div>
            </article>
          ))}
        </div>
        <div class="agent-controls">
          <p class="agent-position" role="status" aria-live="polite" aria-atomic="true" data-coverflow-status>1 of {agents.length} · {agents[0].name}</p>
          <button type="button" class="agent-toggle" data-coverflow-toggle aria-pressed="false" aria-label="Play the agent carousel"><span data-coverflow-toggle-label>Play</span><svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path class="agent-play-icon" d="m6 4 6 4-6 4V4Z" fill="currentColor" /><path class="agent-pause-icon" d="M5.5 4v8m5-8v8" stroke="currentColor" stroke-width="1.5" /></svg></button>
          <div class="agent-nav">
            <button type="button" data-coverflow-prev aria-label="Previous agent" aria-controls="agent-stage"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="m14 6-6 6 6 6M8 12h12" /></svg></button>
            <button type="button" data-coverflow-next aria-label="Next agent" aria-controls="agent-stage"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="m10 6 6 6-6 6M16 12H4" /></svg></button>
          </div>
        </div>
      </div>
    </div>
    <div class="agent-section-foot"><p>Built for useful work. Designed for human oversight.</p><a href="/agents">All agent projects <span aria-hidden="true">↗</span></a></div>
  </div>
</section>
<script>
  import { initCoverflow } from "../scripts/coverflow";

  const root = document.querySelector<HTMLElement>("[data-agent-carousel]");
  if (root) initCoverflow(root);
</script>
<style>
  .agent-carousel{margin-top:44px;border:1px solid var(--line-strong);background:var(--surface)}
  .agent-directory{background:var(--ink);min-width:0;display:flex;flex-direction:column}
  .agent-directory-heading,.agent-workspace-heading{display:flex;justify-content:space-between;align-items:center;gap:16px;min-height:58px;padding:16px 24px;font:9px/1.5 var(--font-mono);text-transform:uppercase;letter-spacing:.12em;color:var(--text-faint);border-bottom:1px solid var(--line)}
  .agent-directory-heading>span:last-child{color:var(--accent)}
  .agent-tabs{display:flex;flex-direction:column}
  .agent-tabs button{position:relative;display:flex;align-items:flex-start;gap:14px;width:100%;min-width:0;min-height:128px;padding:26px 22px;text-align:left;color:var(--text-dim);background:transparent;border-bottom:1px solid var(--line);cursor:pointer;transition:background 220ms,color 220ms}
  .agent-tabs button::before{content:"";position:absolute;left:0;top:0;bottom:0;width:2px;background:var(--accent);transform:scaleY(0);transform-origin:center;transition:transform 300ms var(--ease)}
  .agent-tabs button[aria-current="true"]{background:var(--accent-wash);color:var(--text)}
  .agent-tabs button[aria-current="true"]::before{transform:scaleY(1)}
  .agent-tab-number{font:10px/2 var(--font-mono);color:var(--text-faint);transition:color 220ms}
  .agent-tabs button[aria-current="true"] .agent-tab-number{color:var(--accent)}
  .agent-tab-copy{font:550 19px/1.2 var(--font-display);letter-spacing:-.025em}
  .agent-tab-copy small{display:block;margin-top:10px;font:400 11px/1.6 var(--font-sans);letter-spacing:0;color:var(--text-dim);max-width:18ch}
  .agent-tab-arrow{margin-left:auto;color:var(--accent);font-size:15px;opacity:0;transform:translate(-3px,3px);transition:transform 250ms,opacity 250ms}
  .agent-tabs button[aria-current="true"] .agent-tab-arrow{opacity:1;transform:none}
  .agent-directory-note{display:flex;gap:14px;margin-top:auto;padding:36px 24px;font-size:11px;line-height:1.7;color:var(--text-faint)}
  .agent-directory-note>span{color:var(--accent)}
  .agent-workspace{min-width:0}
  .agent-workspace-heading>span:last-child{color:var(--accent);font-size:8px;letter-spacing:.08em}
  .agent-stage{display:grid;gap:24px;overflow:hidden;isolation:isolate;touch-action:pan-y pinch-zoom}
  .agent-panel{min-width:0;background:var(--surface);border-bottom:1px solid var(--line)}
  .agent-preview{display:block;position:relative;margin:22px 24px 0;border:1px solid var(--line-strong);overflow:hidden;background:var(--ink-deep)}
  .agent-preview-image{aspect-ratio:16/9;overflow:hidden;display:grid;place-items:center}
  .agent-preview img{width:100%;height:100%;object-fit:cover;object-position:top;transition:transform 600ms cubic-bezier(.2,.65,.2,1)}
  .agent-preview-link{display:flex;align-items:center;justify-content:space-between;gap:16px;min-height:44px;padding:12px 16px;font-size:10px;color:var(--text-dim);background:var(--ink);border-top:1px solid var(--line)}
  .agent-preview-link>span:last-child{color:var(--accent);font-size:15px;transition:transform 250ms}
  .agent-info{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,1fr);gap:32px;padding:30px 28px 32px}
  .agent-overview>.section-label{font-size:8px;line-height:1.7;margin-bottom:12px}
  .agent-info h3{font:600 clamp(2rem,3.8vw,3.4rem)/1.05 var(--font-display);letter-spacing:-.055em}
  .agent-info h3>span{color:var(--accent)}
  .agent-summary{color:var(--text-dim);font-size:13px;line-height:1.75;margin-top:16px;max-width:52ch}
  .agent-details{display:flex;flex-direction:column;border-left:1px solid var(--line);padding-left:28px}
  .agent-info ul{display:grid;gap:10px;list-style:none;padding:0;margin:0 0 20px}
  .agent-info li{display:flex;gap:10px;font-size:11px;line-height:1.5;color:var(--text-dim)}
  .agent-info li>span{color:var(--accent)}
  .agent-demo-link{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:auto;min-height:44px;border-top:1px solid var(--line-strong);font-size:12px;font-weight:550;color:var(--text);transition:color 200ms}
  .agent-demo-link>span{font-size:17px;color:var(--accent);transition:transform 250ms}
  .agent-note{font:9px/1.6 var(--font-mono);color:var(--text-faint);margin-top:8px}
  .agent-controls{display:flex;align-items:center;gap:20px;min-height:76px;padding:14px 24px;background:var(--ink)}
  .agent-position{margin-right:auto;font:10px/1.5 var(--font-mono);color:var(--text-dim)}
  .agent-toggle{display:flex;align-items:center;gap:8px;min-height:44px;padding:0 10px;background:transparent;color:var(--text-dim);font:9px var(--font-mono);text-transform:uppercase;letter-spacing:.08em;cursor:pointer;transition:color 180ms}
  .agent-toggle svg{width:16px;height:16px}
  .agent-pause-icon,.agent-toggle[aria-pressed="true"] .agent-play-icon{display:none}
  .agent-toggle[aria-pressed="true"] .agent-pause-icon{display:block}
  .agent-toggle:disabled{cursor:default;opacity:.65}
  .agent-nav{display:flex;gap:8px}
  .agent-nav button{width:44px;height:44px;display:grid;place-items:center;border:1px solid var(--line-control);background:transparent;color:var(--text);cursor:pointer;transition:background 220ms,color 220ms,border-color 220ms}
  .agent-nav svg{width:19px;height:19px;transition:transform 250ms}
  .agent-carousel[data-coverflow-ready]{display:grid;grid-template-columns:240px minmax(0,1fr)}
  .agent-carousel[data-coverflow-ready] .agent-directory{border-right:1px solid var(--line-strong)}
  .agent-carousel[data-coverflow-ready] .agent-stage{gap:0}
  .agent-carousel[data-coverflow-ready] .agent-panel{grid-area:1/1;opacity:0;visibility:hidden;pointer-events:none;transition:opacity 340ms ease,visibility 340ms}
  .agent-carousel[data-coverflow-ready] .agent-panel[data-state="active"]{opacity:1;visibility:visible;pointer-events:auto;z-index:1}
  .agent-carousel[data-coverflow-ready] .agent-panel[data-state="leaving"]{visibility:visible}
  .agent-carousel[data-coverflow-ready] .agent-preview{transform:translateX(calc(var(--agent-direction,1) * 24px));transition:transform 580ms cubic-bezier(.2,.65,.2,1)}
  .agent-carousel[data-coverflow-ready] .agent-info{opacity:0;transform:translateY(12px);transition:opacity 350ms ease,transform 500ms cubic-bezier(.2,.65,.2,1)}
  .agent-carousel[data-coverflow-ready] .agent-panel[data-state="active"] .agent-preview{transform:none;animation:agent-preview-enter 580ms cubic-bezier(.2,.65,.2,1) both}
  .agent-carousel[data-coverflow-ready] .agent-panel[data-state="active"] .agent-info{opacity:1;transform:none;transition-delay:80ms}
  .agent-carousel[data-coverflow-ready] .agent-panel[data-state="leaving"] .agent-preview{transform:translateX(calc(var(--agent-direction,1) * -16px))}
  @keyframes agent-preview-enter{from{transform:translateX(calc(var(--agent-direction,1) * 24px))}to{transform:translateX(0)}}
  .agent-carousel:not([data-coverflow-ready]) .agent-directory,.agent-carousel:not([data-coverflow-ready]) .agent-controls{display:none}
  .agent-section-foot{display:flex;justify-content:space-between;gap:20px;padding-top:20px;margin-top:20px;font-size:11px;color:var(--text-faint)}
  .agent-section-foot a{color:var(--accent);display:flex;gap:20px;min-height:44px;align-items:center}
  .agent-section-foot p{align-self:center}
  @media(hover:hover){
    .agent-tabs button:hover{background:var(--surface-raised);color:var(--text)}
    .agent-preview:hover img{transform:scale(1.015)}
    .agent-preview:hover .agent-preview-link>span:last-child,.agent-demo-link:hover>span{transform:translate(2px,-2px)}
    .agent-demo-link:hover,.agent-toggle:hover{color:var(--accent)}
    .agent-nav button:hover{color:var(--accent);background:var(--accent-wash);border-color:var(--accent-edge)}
    .agent-nav button:first-child:hover svg{transform:translateX(-2px)}
    .agent-nav button:last-child:hover svg{transform:translateX(2px)}
  }
  @media(max-width:1050px){
    .agent-carousel[data-coverflow-ready]{grid-template-columns:210px minmax(0,1fr)}
    .agent-tabs button{gap:10px;padding:24px 16px}
    .agent-tab-copy{font-size:17px}
    .agent-directory-heading{padding:16px}
    .agent-info{gap:20px;padding:26px 24px}
    .agent-details{padding-left:20px}
  }
  @media(max-width:800px){
    .agent-carousel[data-coverflow-ready]{grid-template-columns:minmax(0,1fr)}
    .agent-carousel[data-coverflow-ready] .agent-directory{border-right:0}
    .agent-directory-heading,.agent-directory-note{display:none}
    .agent-tabs{display:grid;grid-template-columns:repeat(3,minmax(0,1fr))}
    .agent-tabs button{min-height:118px;border-right:1px solid var(--line);padding:22px 16px}
    .agent-tabs button:last-child{border-right:0}
    .agent-tabs button::before{top:auto;right:0;width:auto;height:2px;transform:scaleX(0)}
    .agent-tabs button[aria-current="true"]::before{transform:scaleX(1)}
    .agent-tab-arrow{display:none}
    .agent-tab-copy small{font-size:10px;margin-top:8px}
    .agent-workspace-heading{min-height:50px}
  }
  @media(max-width:540px){
    .agent-carousel{margin-top:30px}
    .agent-tabs button{flex-direction:column;gap:8px;min-height:96px;padding:16px 12px}
    .agent-tab-number{font-size:9px;line-height:1}
    .agent-tab-copy{font-size:15px;line-height:1.3}
    .agent-tab-copy small{display:none}
    .agent-workspace-heading{padding:14px 16px;font-size:8px;letter-spacing:.08em;gap:10px}
    .agent-workspace-heading>span:last-child{font-size:7px;letter-spacing:.04em}
    .agent-preview{margin:14px 14px 0}
    .agent-preview-link{padding:10px 12px;font-size:9px}
    .agent-info{grid-template-columns:minmax(0,1fr);gap:24px;padding:24px 20px}
    .agent-details{padding:0;border-left:0}
    .agent-info h3{font-size:2.6rem}
    .agent-summary{font-size:12px;margin-top:14px}
    .agent-info ul{gap:9px;margin-bottom:16px}
    .agent-demo-link{font-size:12px}
    .agent-controls{gap:8px;padding:12px 14px}
    .agent-position{font-size:9px}
    .agent-toggle{padding:0 6px}
    .agent-nav{gap:5px}
    .agent-section-foot{flex-direction:column;gap:4px;margin-top:14px}
    .agent-section-foot p{align-self:flex-start}
  }
  @media(prefers-reduced-motion:reduce){
    .agent-carousel[data-coverflow-ready] .agent-panel[data-state="active"] .agent-preview{animation:none}
    .agent-carousel[data-coverflow-ready] .agent-panel,.agent-carousel[data-coverflow-ready] .agent-preview,.agent-carousel[data-coverflow-ready] .agent-info,.agent-tabs button,.agent-tabs button::before,.agent-tab-number,.agent-tab-arrow,.agent-preview img,.agent-preview-link>span:last-child,.agent-demo-link,.agent-demo-link>span,.agent-toggle,.agent-nav button,.agent-nav svg{transition:none}
    .agent-preview:hover img,.agent-preview:hover .agent-preview-link>span:last-child,.agent-demo-link:hover>span,.agent-nav button:hover svg{transform:none}
  }
</style>
